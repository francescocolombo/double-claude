cmd_help() {
  cat <<EOF
${_b}double-claude${_r} ${_d}$DC_VERSION${_r}  due account Claude sullo stesso Mac, senza che si mescolino

  ${_b}init${_r}          configura i due profili con qualche domanda
  ${_b}doctor${_r}        controlla cosa è già separato e cosa no
  ${_b}plan${_r}          mostra cosa farebbe apply, senza cambiare niente
  ${_b}apply${_r} [pezzi] separa tutto, oppure solo: shell move mcp deny app
  ${_b}open${_r} NOME     apre l'app del profilo giusto (usato dai launcher)
  ${_b}status${_r}        mostra le app Claude aperte e il loro profilo
  ${_b}backup${_r}        salva una copia delle configurazioni
  ${_b}restore${_r} [n]   torna a un backup (il più recente se non indichi n)
  ${_b}install${_r}       si copia in ~/.local/bin

  Opzione: ${_b}--yes${_r} accetta le risposte predefinite.
