#!/bin/zsh
# Double Claude (double-claude): due account Claude sullo stesso Mac, senza che si mescolino.
#
# Separa i due profili su quattro livelli:
#   1. account       login dal browser, uno alla volta
#   2. app Desktop   una seconda copia dell'app con --user-data-dir
#   3. Claude Code   una config propria con CLAUDE_CONFIG_DIR (anche nella scheda Code dell'app)
#   4. cartelle      divieti Read/Edit e, se vuoi, cartelle dedicate a un profilo
#
# Uso rapido:  double-claude init  →  double-claude doctor  →  double-claude apply
# Licenza: MIT. Nessun dato lascia il Mac.

emulate -R zsh
setopt extended_glob null_glob pipe_fail
# A è sempre ~/.claude: se double-claude parte da una sessione di B (per esempio la scheda Code dell'app di B),
# CLAUDE_CONFIG_DIR ereditata manderebbe a B i comandi pensati per A.
unset CLAUDE_CONFIG_DIR

DC_VERSION=1.3.0
DC_HOME_CFG=${DC_CONFIG_HOME:-$HOME/.config/double-claude}
DC_CONF=$DC_HOME_CFG/config
SELF=${0:A}
DC_YES=0
DC_TODO=0

# ---------------------------------------------------------------- aspetto
if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
  _b=$'\e[1m' _d=$'\e[2m' _r=$'\e[0m' _g=$'\e[32m' _y=$'\e[33m' _red=$'\e[31m' _a=$'\e[34m' _o=$'\e[33m'
else
  _b= _d= _r= _g= _y= _red= _a= _o=
fi
say()  { print -r -- "$*"; }
h1()   { print; print -r -- "${_b}$*${_r}"; }
h2()   { print; print -r -- "${_b}$*${_r}"; }
ok()   { print -r -- "  ${_g}✓${_r} $*"; }
ko()   { print -r -- "  ${_red}✗${_r} $*"; DC_TODO=$(( DC_TODO + 1 )); return 0; }
warn() { print -r -- "  ${_y}!${_r} $*"; }
hint() { print -r -- "    ${_d}→ $*${_r}"; }
die()  { print -u2 -r -- "${_red}errore:${_r} $*"; exit 1; }

ask() { # ask VAR "domanda" [predefinito]
  local __v=$1 __q=$2 __d=${3:-} __x=''
  if (( DC_YES )); then __x=$__d
  else read -r "__x?  $__q${__d:+ ${_d}[$__d]${_r}}: " || __x=''; [[ -t 0 ]] || print -r -- "  $__q: ${__x:-$__d}"; fi
  [[ -z $__x ]] && __x=$__d
  typeset -g "$__v=$__x"
}
confirm() { # confirm "domanda" [S|N]
  local d=${2:-S} x=''
  (( DC_YES )) && [[ $d == S ]] && return 0
  (( DC_YES )) && return 1
  read -r "x?  $1 ${_d}[$([[ $d == S ]] && print S/n || print s/N)]${_r} " || x=''
  x=${x:-$d}
  [[ -t 0 ]] || print -r -- "  $1 ${x}"
  [[ $x == [SsYy]* ]]
}

# ---------------------------------------------------------------- percorsi
expand() { local p=${1/#\~/$HOME}; p=${p%%/##}; [[ $p != /* ]] && p=$HOME/$p; print -r -- "$p"; }
tilde()  { local p=$1; [[ $p == $HOME ]] && p='~'; [[ $p == $HOME/* ]] && p="~/${p#$HOME/}"; print -r -- "$p"; }
rule_of(){ local p=$1; if [[ $p == $HOME/* ]]; then print -r -- "~/${p#$HOME/}"; else print -r -- "/$p"; fi; }

# ---------------------------------------------------------------- configurazione
defaults() {
  DC_START=two
  DC_A_LABEL=work
  DC_B_LABEL=personal
  DC_A_APP=Claude
  DC_A_DIRS=()             # cartelle dedicate ad A: se ce ne sono, A lavora solo lì (facoltative)
  DC_B_DIRS=()             # lo stesso per B
  DC_ZONE_OWNER=none DC_ZONE_DIRS=()   # formato della 1.1.0, letto ancora da load()
  DC_MCP_MOVE=()
  DC_A_DENY_EXTRA=()
  DC_B_DENY_EXTRA=()
  DC_MODULES=(shell move mcp deny app)
  DC_LAUNCHER_HIDE=0       # 1 = launcher fuori dal Dock (LSUIElement), ma non si possono fissare
  DC_SANDBOX=0             # 1 = sandbox di Claude Code per i comandi Bash dei due profili
  DC_KEEP_BACKUPS=5        # quanti backup tenere
  DC_APP_SRC=${DC_APP:-/Applications/Claude.app}
  unset DC_B_CMD DC_B_APP DC_B_CFG DC_B_DATA DC_CLONE
}
derive() {
  : ${DC_B_CMD:=claude-$DC_B_LABEL}
  : "${DC_B_APP:=Claude ${(C)DC_B_LABEL}}"
  : "${DC_B_CFG:=$HOME/.$DC_B_CMD}"
  : "${DC_B_DATA:=$HOME/Library/Application Support/${DC_B_APP// /-}}"
  : "${DC_CLONE:=$HOME/Library/Application Support/$DC_B_CMD-app.noindex/$DC_B_APP.app}"
  DC_A_CFG=$HOME/.claude
  DC_A_JSON=$HOME/.claude.json
  DC_A_DATA="$HOME/Library/Application Support/Claude"
  DC_B_3P="$DC_B_DATA-3p"
  CLAUDE_BIN=$(whence -p claude 2>/dev/null)
}
load() {
  defaults; [[ -f $DC_CONF ]] && source "$DC_CONF"
  if (( ! $#DC_A_DIRS && ! $#DC_B_DIRS )); then   # config della 1.1.0: una zona con un proprietario
    [[ $DC_ZONE_OWNER == a ]] && DC_A_DIRS=($DC_ZONE_DIRS)
    [[ $DC_ZONE_OWNER == b ]] && DC_B_DIRS=($DC_ZONE_DIRS)
  fi
  derive
}
has_dirs() { (( $#DC_A_DIRS || $#DC_B_DIRS )); }
dirs_of()  { local d out=(); for d in "$@"; do out+=("$(tilde $d)"); done; print -r -- "${(j:, :)out}"; }
b_start()  { tilde "${DC_B_DIRS[1]:-$HOME}"; }   # dove B può partire per il login
need_conf() { [[ -f $DC_CONF ]] || die "nessuna configurazione. Lancia prima: double-claude init"; }
has_mod() { (( ${DC_MODULES[(Ie)$1]} )); }
is_mac()  { [[ $OSTYPE == darwin* || -n ${DC_FAKE_MAC:-} ]]; }

save_conf() {
  mkdir -p "$DC_HOME_CFG"
  {
    print "# double-claude: configurazione. Generata da 'double-claude init', puoi modificarla a mano."
    print -r "DC_START=${(q)DC_START}            # one | two | split"
    print -r "DC_A_LABEL=${(q)DC_A_LABEL}"
    print -r "DC_B_LABEL=${(q)DC_B_LABEL}"
    print -r "DC_A_APP=${(q)DC_A_APP}"
    print -r "DC_B_APP=${(q)DC_B_APP}"
    print -r "DC_B_CMD=${(q)DC_B_CMD}"
    print -r "DC_B_CFG=${(q)DC_B_CFG}"
    print -r "DC_A_DIRS=(${(@q)DC_A_DIRS})            # cartelle dedicate ad A (vuoto = nessuna)"
    print -r "DC_B_DIRS=(${(@q)DC_B_DIRS})            # cartelle dedicate a B (vuoto = nessuna)"
    print -r "DC_MCP_MOVE=(${(@q)DC_MCP_MOVE})"
    print -r "DC_A_DENY_EXTRA=(${(@q)DC_A_DENY_EXTRA})"
    print -r "DC_B_DENY_EXTRA=(${(@q)DC_B_DENY_EXTRA})"
    print -r "DC_MODULES=(${(@q)DC_MODULES})"
    print -r "DC_LAUNCHER_HIDE=${(q)DC_LAUNCHER_HIDE}       # 1 = launcher fuori dal Dock"
    print -r "DC_SANDBOX=${(q)DC_SANDBOX}             # 1 = sandbox per i comandi Bash dei due profili"
  } > "$DC_CONF"
}

# ---------------------------------------------------------------- motore JSON
# Il motore è JavaScript: su macOS gira con JXA (osascript), nei test con node.
engine() { # engine COMANDO   (input dalle variabili DC_*)
  local src; src=$(engine_src)
  local -x DC_CMD=$1 DC_ADIRS=${(pj:\n:)DC_A_DIRS} DC_BDIRS=${(pj:\n:)DC_B_DIRS} DC_BCFG=$DC_B_CFG
  local -x DC_ADATA=$DC_A_DATA DC_BDATA=$DC_B_DATA DC_B3P=$DC_B_3P DC_STATE=$DC_HOME_CFG/state.json
  if [[ ${DC_JS_RUNTIME:-} == node ]]; then node - <<< "$src"
  else osascript -l JavaScript <<< "$src"; fi
}
engine_src() { cat <<'JS'
var IS_JXA = (typeof ObjC !== 'undefined');
var io = IS_JXA ? (function () {
  ObjC.import('Foundation');
  var fm = $.NSFileManager.defaultManager;
  var env = ObjC.deepUnwrap($.NSProcessInfo.processInfo.environment) || {};
  return {
    env: function (k) { return env[k] || ''; },
    exists: function (p) { return fm.fileExistsAtPath(p); },
    isDir: function (p) { var r = Ref(); return fm.fileExistsAtPathIsDirectory(p, r) && r[0]; },
    read: function (p) { if (!fm.fileExistsAtPath(p)) return ''; return ObjC.unwrap($.NSString.stringWithContentsOfFileEncodingError(p, 4, null)) || ''; },
    write: function (p, s) { return $(s).writeToFileAtomicallyEncodingError(p, true, 4, null); },
    ls: function (p) { var a = ObjC.deepUnwrap(fm.contentsOfDirectoryAtPathError(p, null)); return Array.isArray(a) ? a : []; },
    mkdirp: function (p) { return fm.createDirectoryAtPathWithIntermediateDirectoriesAttributesError(p, true, $(), null); },
    mv: function (a, b) { return fm.moveItemAtPathToPathError(a, b, null); },
    cp: function (a, b) { return fm.copyItemAtPathToPathError(a, b, null); },
    rmEmpty: function (p) { var a = ObjC.deepUnwrap(fm.contentsOfDirectoryAtPathError(p, null)); if (Array.isArray(a) && a.length === 0) fm.removeItemAtPathError(p, null); },
    uuid: function () { return ObjC.unwrap($.NSUUID.UUID.UUIDString); }
  };
})() : (function () {
  var fs = require('fs');
  return {
    env: function (k) { return process.env[k] || ''; },
    exists: function (p) { return fs.existsSync(p); },
    isDir: function (p) { try { return fs.statSync(p).isDirectory(); } catch (e) { return false; } },
    read: function (p) { return fs.existsSync(p) ? fs.readFileSync(p, 'utf8') : ''; },
    write: function (p, s) { fs.writeFileSync(p + '.tmp', s); fs.renameSync(p + '.tmp', p); return true; },
    ls: function (p) { try { return fs.readdirSync(p); } catch (e) { return []; } },
    mkdirp: function (p) { fs.mkdirSync(p, { recursive: true }); return true; },
    mv: function (a, b) { try { fs.renameSync(a, b); return true; } catch (e) { return false; } },
    cp: function (a, b) { try { fs.copyFileSync(a, b); return true; } catch (e) { return false; } },
    rmEmpty: function (p) { try { fs.rmdirSync(p); } catch (e) {} },
    uuid: function () { return require('crypto').randomUUID().toUpperCase(); }
  };
})();

function main() {
  var HOME = io.env('HOME'), cmd = io.env('DC_CMD');
  var A = HOME + '/.claude', AJ = HOME + '/.claude.json', B = io.env('DC_BCFG'), BJ = B + '/.claude.json';
  var adirs = io.env('DC_ADIRS').split('\n').filter(Boolean), bdirs = io.env('DC_BDIRS').split('\n').filter(Boolean);
  var enc = function (p) { return p.replace(/[^A-Za-z0-9]/g, '-'); };
  var inDirs = function (ds, p) { return ds.some(function (z) { return p === z || p.indexOf(z + '/') === 0; }); };
  var nameInDirs = function (ds, n) { return ds.some(function (z) { var e = enc(z); return n === e || n.indexOf(e + '-') === 0; }); };
  // Una chat aperta dentro i dati di un'app (le cartelle di lavoro della scheda Code) è di quell'app, sempre.
  // Altrimenti è di B se è nelle cartelle di B, oppure se è fuori da quelle di A quando solo A ne ha.
  var adata = [io.env('DC_ADATA')].filter(Boolean), bdata = [io.env('DC_BDATA')].filter(Boolean);
  var onlyA = adirs.length > 0 && bdirs.length === 0;
  var pathToB = function (p) { return inDirs(bdata, p) ? true : inDirs(adata, p) ? false : inDirs(bdirs, p) ? true : inDirs(adirs, p) ? false : onlyA; };
  var nameToB = function (n) { return nameInDirs(bdata, n) ? true : nameInDirs(adata, n) ? false : nameInDirs(bdirs, n) ? true : nameInDirs(adirs, n) ? false : onlyA; };
  var tilde = function (p) { return p === HOME ? '~' : p.indexOf(HOME + '/') === 0 ? '~' + p.slice(HOME.length) : p; };
  var json = function (p) { var t = io.read(p); if (!t.trim()) return null; try { return JSON.parse(t); } catch (e) { return undefined; } };
  var lines = function (s) { return s.split('\n').filter(function (l) { return l.trim(); }); };

  // La cartella di una chat dice dove è stata aperta: il campo cwd nei suoi .jsonl è la fonte più precisa.
  function chatCwd(dir) {
    var files = io.ls(dir).filter(function (f) { return /\.jsonl$/.test(f); });
    for (var i = 0; i < files.length; i++) {
      var m = io.read(dir + '/' + files[i]).match(/"cwd"\s*:\s*"((?:[^"\\]|\\.)*)"/);
      if (m) { try { return JSON.parse('"' + m[1] + '"'); } catch (e) {} }
    }
    return '';
  }
  function classify() {
    var r = { chats: [], move: [], keep: [], reg: [], ja: json(AJ) };
    io.ls(A + '/projects').forEach(function (n) {
      var d = A + '/projects/' + n;
      if (!io.isDir(d)) return;
      var cwd = chatCwd(d);
      if (cwd ? pathToB(cwd) : nameToB(n)) r.chats.push({ name: n, cwd: cwd });
    });
    lines(io.read(A + '/history.jsonl')).forEach(function (l) {
      var p = ''; try { p = JSON.parse(l).project || ''; } catch (e) {}
      (p && pathToB(p) ? r.move : r.keep).push(l);
    });
    if (r.ja && r.ja.projects) r.reg = Object.keys(r.ja.projects).filter(pathToB);
    return r;
  }
  // Blocco degli aggiornamenti: Claude legge una policy locale da <dati>-3p/configLibrary.
  // La cartella -3p serve anche alle configurazioni di inferenza (Bedrock, Vertex...): se non l'abbiamo creata noi, non si tocca.
  var P3 = io.env('DC_B3P'), LIB = P3 + '/configLibrary', MARK = P3 + '/.double-claude';
  function updates() {
    if (!io.exists(P3)) return 'none';
    var meta = json(LIB + '/_meta.json'), id = meta && meta.appliedId, pol = id ? json(LIB + '/' + id + '.json') : null;
    return pol && pol.disableAutoUpdates === true ? 'off' : 'on';
  }
  function appAccount(dir) { var j = json(dir + '/config.json'); return (j && j.lastKnownAccountUuid) || ''; }

  if (cmd === 'scan') {
    var ja = json(AJ), jb = json(BJ), r = classify();
    var email = function (j) { return (j && j.oauthAccount && j.oauthAccount.emailAddress) || ''; };
    return [
      'json_a=' + (ja === undefined ? 'broken' : ja ? 'ok' : 'missing'),
      'json_b=' + (jb === undefined ? 'broken' : jb ? 'ok' : 'missing'),
      'account_a=' + email(ja), 'account_b=' + email(jb),
      'mcp_a=' + Object.keys((ja && ja.mcpServers) || {}).join(' '),
      'mcp_b=' + Object.keys((jb && jb.mcpServers) || {}).join(' '),
      'chats_b=' + r.chats.length, 'history_b=' + r.move.length, 'registry_b=' + r.reg.length,
      'updates_b=' + updates(), 'updates_ours=' + (io.exists(MARK) ? 1 : 0),
      'app_same=' + (function (a, b) { return a && a === b ? 1 : 0; })(appAccount(io.env('DC_ADATA')), appAccount(io.env('DC_BDATA')))
    ].join('\n');
  }

  if (cmd === 'policy-set') {
    if (io.exists(P3) && !io.exists(MARK)) return 'foreign';
    var meta = json(LIB + '/_meta.json'), id = (meta && meta.appliedId) || io.uuid();
    io.mkdirp(LIB);
    io.write(LIB + '/_meta.json', JSON.stringify({ appliedId: id, entries: [{ id: id, name: 'Default' }] }, null, 2));
    io.write(LIB + '/' + id + '.json', JSON.stringify({ disableAutoUpdates: true }, null, 2));
    io.write(MARK, 'Creata da double-claude: blocca l\'aggiornamento automatico della copia dell\'app.\n');
    return 'ours';
  }

  if (cmd === 'move') {
    var dry = io.env('DC_DRY') !== '0', m = classify(), out = [];
    if (m.ja === undefined) return 'ERRORE: ~/.claude.json non è un JSON valido. Non tocco niente.';
    var jb = json(BJ);
    if (jb === undefined) return 'ERRORE: ' + tilde(BJ) + ' non è un JSON valido. Non tocco niente.';
    out.push(dry ? 'Prova: non cambia niente.' : 'Sposto in ' + tilde(B) + ':');
    m.chats.forEach(function (c) {
      out.push('  chat        ' + (c.cwd ? tilde(c.cwd) : c.name));
      if (dry) return;
      var src = A + '/projects/' + c.name, dst = B + '/projects/' + c.name;
      io.ls(src).forEach(function (f) {
        var id = f.replace(/\.jsonl$/, '');
        if (id !== f) {
          ['file-history', 'session-env'].forEach(function (sub) {
            if (io.exists(A + '/' + sub + '/' + id) && !io.exists(B + '/' + sub + '/' + id)) { io.mkdirp(B + '/' + sub); io.mv(A + '/' + sub + '/' + id, B + '/' + sub + '/' + id); }
          });
          io.ls(A + '/todos').forEach(function (t) { if (t.indexOf(id) === 0 && !io.exists(B + '/todos/' + t)) { io.mkdirp(B + '/todos'); io.mv(A + '/todos/' + t, B + '/todos/' + t); } });
        }
      });
      if (!io.exists(dst)) { io.mkdirp(B + '/projects'); if (!io.mv(src, dst)) out.push('    ! non spostata'); return; }
      io.ls(src).forEach(function (f) { if (!io.exists(dst + '/' + f)) io.mv(src + '/' + f, dst + '/' + f); });
      io.rmEmpty(src);
      if (io.exists(src)) out.push('    ! alcuni file esistono già in B e sono rimasti in A');
    });
    out.push('  cronologia  ' + m.move.length + ' righe passano a B, ' + m.keep.length + ' restano in A');
    m.reg.forEach(function (k) { out.push('  registro    ' + tilde(k) + '  ' + (dry ? 'passa a B' : 'spostato in B') + ' con permessi e server MCP del progetto'); });
    if (!dry) {
      if (m.move.length) {
        io.mkdirp(B);
        var old = io.read(B + '/history.jsonl'); if (old && old.slice(-1) !== '\n') old += '\n';
        io.write(B + '/history.jsonl', old + m.move.join('\n') + '\n');
        io.write(A + '/history.jsonl', m.keep.length ? m.keep.join('\n') + '\n' : '');
      }
      if (m.reg.length) {
        // prima B, poi A: se la scrittura in B non riesce, A resta com'era
        jb = jb || {}; jb.projects = jb.projects || {};
        m.reg.forEach(function (k) { if (!jb.projects[k]) jb.projects[k] = m.ja.projects[k]; });
        io.mkdirp(B);
        if (!io.write(BJ, JSON.stringify(jb, null, 2))) return 'ERRORE: non riesco a scrivere ' + tilde(BJ) + '. Il registro di A non è cambiato.';
        m.reg.forEach(function (k) { delete m.ja.projects[k]; });
        io.write(AJ, JSON.stringify(m.ja, null, 2));
      }
    }
    out.push('', (dry ? 'Da spostare: ' : 'Spostati: ') + m.chats.length + ' chat, ' + m.move.length + ' righe di cronologia, ' + m.reg.length + ' voci di registro.');
    return out.join('\n');
  }

  if (cmd === 'mcp-get') {
    var j = json(AJ), s = j && j.mcpServers && j.mcpServers[io.env('DC_ARG')];
    return s ? JSON.stringify(s) : '';
  }

  // Impostazioni di un profilo: divieti, cartelle di lavoro, blocco delle letture, sandbox.
  // In state.json Double Claude ricorda cosa ha scritto in ogni file: toglie solo quello, mai le regole dell'utente.
  if (cmd === 'settings-check' || cmd === 'settings') {
    var file = io.env('DC_FILE'), STATE = io.env('DC_STATE');
    var wantDeny = lines(io.env('DC_RULES')), wantDirs = lines(io.env('DC_DIRS'));
    var wantBlock = io.env('DC_BLOCK') === '1', wantSandbox = io.env('DC_SANDBOX') === '1';
    var cur = json(file);
    if (cur === undefined) return 'error=' + tilde(file) + ' non è un JSON valido';
    cur = cur || {};
    var perm = cur.permissions || {}, deny = perm.deny || [], dirs = perm.additionalDirectories || [];
    var sb = cur.sandbox || {};
    var state = json(STATE) || {}, prev = state[file] || {};
    var pDeny = prev.deny || [], pDirs = prev.dirs || [];
    var has = function (arr) { return function (x) { return arr.indexOf(x) >= 0; }; }, not = function (f) { return function (x) { return !f(x); }; };
    if (cmd === 'settings-check') {
      return ['deny_missing=' + wantDeny.filter(not(has(deny))).length,
              'deny_stale=' + pDeny.filter(not(has(wantDeny))).filter(has(deny)).length,
              'dirs_missing=' + wantDirs.filter(not(has(dirs))).length,
              'block=' + (perm.blockReadsOutsideWorkingDirectories === true ? 1 : 0),
              'block_ours=' + (prev.block ? 1 : 0),
              'sandbox=' + (sb.enabled === true ? 1 : 0),
              'sandbox_ours=' + (prev.sandbox ? 1 : 0)].join('\n');
    }
    var staleDeny = pDeny.filter(not(has(wantDeny))), staleDirs = pDirs.filter(not(has(wantDirs)));
    var addDeny = wantDeny.filter(not(has(deny))), addDirs = wantDirs.filter(not(has(dirs)));
    var next = { deny: pDeny.filter(has(wantDeny)).concat(addDeny), dirs: pDirs.filter(has(wantDirs)).concat(addDirs), block: !!prev.block, sandbox: !!prev.sandbox };
    perm.deny = deny.filter(not(has(staleDeny))).concat(addDeny);
    perm.additionalDirectories = dirs.filter(not(has(staleDirs))).concat(addDirs);
    if (!perm.additionalDirectories.length) delete perm.additionalDirectories;
    if (wantBlock && perm.blockReadsOutsideWorkingDirectories !== true) { perm.blockReadsOutsideWorkingDirectories = true; next.block = true; }
    if (!wantBlock && prev.block) { delete perm.blockReadsOutsideWorkingDirectories; next.block = false; }
    if (wantSandbox && sb.enabled !== true) { sb.enabled = true; cur.sandbox = sb; next.sandbox = true; }
    if (!wantSandbox && prev.sandbox) { delete sb.enabled; if (Object.keys(sb).length) cur.sandbox = sb; else delete cur.sandbox; next.sandbox = false; }
    cur.permissions = perm;
    if (io.exists(file) && !io.exists(file + '.bak')) io.cp(file, file + '.bak');
    io.mkdirp(file.replace(/\/[^\/]*$/, ''));
    io.write(file, JSON.stringify(cur, null, 2));
    state[file] = next;
    io.mkdirp(STATE.replace(/\/[^\/]*$/, ''));
    io.write(STATE, JSON.stringify(state, null, 2));
    return ['added=' + addDeny.length, 'removed=' + staleDeny.length, 'dirs=' + addDirs.length, 'dirs_removed=' + staleDirs.length].join('\n');
  }
  return 'comando sconosciuto: ' + cmd;
}
function run() { return main(); }
if (!IS_JXA) { var __o = main(); if (__o) process.stdout.write(__o + '\n'); }
JS
}

scan() { # riempie l'array associativo S
  typeset -gA S; S=()
  local k v
  while IFS='=' read -r k v; do [[ -n $k ]] && S[$k]=$v; done < <(engine scan 2>/dev/null)
  [[ -n ${S[json_a]:-} ]] || die "non riesco a leggere le configurazioni (osascript non risponde)."
}

# ---------------------------------------------------------------- regole dei divieti
rw()  { local r; r=$(rule_of "$1"); print -r -- "Read($r/**)"; print -r -- "Edit($r/**)"; }
rwf() { local r; r=$(rule_of "$1"); print -r -- "Read($r)"; print -r -- "Edit($r)"; }
rules_a() { # cosa A non deve toccare
  rw "$DC_B_CFG"; rw "$DC_B_DATA"
  for d in $DC_B_DIRS; do rw "$d"; done
  for d in $DC_A_DENY_EXTRA; do rw "$d"; done
}
rules_b() { # cosa B non deve toccare
  rw "$DC_A_CFG"; rwf "$DC_A_JSON"; rw "$DC_A_DATA"
  for d in $DC_A_DIRS; do rw "$d"; done
  for d in $DC_B_DENY_EXTRA; do rw "$d"; done
}
# Le impostazioni che Double Claude scrive in un profilo: i divieti, le cartelle dedicate come cartelle di lavoro,
# il blocco delle letture fuori da quelle cartelle (solo se il profilo ne ha) e, se scelto, il sandbox.
BLOCK_MIN=2.1.257   # prima versione di Claude Code con permissions.blockReadsOutsideWorkingDirectories
settings_of() { # settings_of a|b settings|settings-check
  local file rules; local -a ds
  if [[ $1 == a ]]; then file=$DC_A_CFG/settings.json rules=$(rules_a) ds=($DC_A_DIRS)
  else file=$DC_B_CFG/settings.json rules=$(rules_b) ds=($DC_B_DIRS); fi
  DC_FILE=$file DC_RULES=$rules DC_DIRS=${(pj:\n:)ds} DC_BLOCK=$(( $#ds ? 1 : 0 )) DC_SANDBOX=$DC_SANDBOX engine $2 2>/dev/null
}
kv() { typeset -gA KV; KV=(); local k v; while IFS='=' read -r k v; do [[ -n $k ]] && KV[$k]=$v; done <<< "$1"; }
claude_version() { [[ -n $CLAUDE_BIN ]] && "$CLAUDE_BIN" --version 2>/dev/null | grep -oE '^[0-9]+(\.[0-9]+)+' | head -1; }
block_too_old() { local v; v=$(claude_version); [[ -n $v && $(vercmp "$v" $BLOCK_MIN) == behind ]] && print -r -- "$v"; }

# ---------------------------------------------------------------- blocco per ~/.zshrc
zsh_block() {
  local B=$DC_B_CMD cfg=${(qq)DC_B_CFG}
  print -r -- "# >>> double-claude >>>"
  print -r -- "# Generato da double-claude. Per cambiarlo: double-claude init && double-claude apply shell"
  if ! has_dirs; then
    print -r -- "$B() { CLAUDE_CONFIG_DIR=$cfg command claude \"\$@\"; }"
  else
    print -r -- "_dc_a=(${(@qq)DC_A_DIRS})"
    print -r -- "_dc_b=(${(@qq)DC_B_DIRS})"
    print -r -- '_dc_admin() { case "$1" in mcp|plugin|plugins|config|update|doctor|install|setup-token|-v|--version|-h|--help) return 0;; esac; return 1; }'
    print -r -- '_dc_in() { local d; for d in "$@"; do [[ "$PWD/" == "$d/"* ]] && return 0; done; return 1; }'
    local fn other ofn own oth olbl body
    for fn in claude $B; do
      if [[ $fn == claude ]]; then own=a oth=b ofn=$B olbl=$DC_B_LABEL; body='command claude "$@"'
      else own=b oth=a ofn=claude olbl=$DC_A_LABEL; body="CLAUDE_CONFIG_DIR=$cfg command claude \"\$@\""; fi
      local -a mine=(${(P)${:-DC_${(U)own}_DIRS}}) theirs=(${(P)${:-DC_${(U)oth}_DIRS}})
      print -r -- "$fn() {"
      print -r -- "  if ! _dc_admin \"\$1\"; then"
      if (( $#mine && $#theirs )); then   # tutti e due hanno cartelle: ognuno lavora solo nelle sue
        print -r -- "    if _dc_in \"\${_dc_${oth}[@]}\"; then print -u2 \"$fn: questa cartella è di $olbl. Qui usa $ofn.\"; return 1; fi"
        print -r -- "    if ! _dc_in \"\${_dc_${own}[@]}\"; then print -u2 \"$fn: lavora solo in $(dirs_of $mine).\"; return 1; fi"
      elif (( $#mine )); then
        print -r -- "    if ! _dc_in \"\${_dc_${own}[@]}\"; then print -u2 \"$fn: lavora solo in $(dirs_of $mine). Qui usa $ofn.\"; return 1; fi"
      else
        print -r -- "    if _dc_in \"\${_dc_${oth}[@]}\"; then print -u2 \"$fn: questa cartella è di $olbl. Qui usa $ofn.\"; return 1; fi"
      fi
      print -r -- "  fi"
      print -r -- "  $body"
      print -r -- "}"
    done
  fi
  print -r -- "# <<< double-claude <<<"
}
strip_block() { # toglie il blocco double-claude da un file
  [[ -f $1 ]] || return 0
  awk '$0=="# >>> double-claude >>>"{s=1;next} $0=="# <<< double-claude <<<"{s=0;next} !s' "$1" > "$1.dc-tmp" && cat "$1.dc-tmp" > "$1" && rm -f "$1.dc-tmp"
}

# ---------------------------------------------------------------- processi e app
running() { # elenco breve dei Claude aperti: app e Terminale
  [[ -n ${DC_SKIP_RUNNING_CHECK:-} ]] && return 0
  ps -A -o pid= -o command= 2>/dev/null | grep -v -e grep -e double-claude | awk '
    /\.app\/Contents\/MacOS\/Claude$/ || /\.app\/Contents\/MacOS\/Claude --/ { print "app Claude (pid " $1 ")"; next }
    $2 == "claude" || $2 ~ /\/claude$/ { print "claude nel Terminale (pid " $1 ")" }'
}
mains()   { ps -A -o pid= -o command= 2>/dev/null | grep -F -- "$1/Contents/MacOS/Claude" | grep -v -e grep -e 'Claude Helper' | sed 's/^ *//'; }
strays()  { mains "$DC_CLONE" | grep -v -- '--user-data-dir=' | awk '{print $1}'; }   # la copia aperta senza il suo profilo
focus()   { osascript -e "tell application \"System Events\" to set frontmost of (first process whose unix id is $1) to true" >/dev/null 2>&1; }
dialog()  { # dialog "messaggio" "pulsante sì": vero se l'utente sceglie il pulsante
  local r; r=$(osascript -e 'on run argv' -e 'display dialog (item 1 of argv) buttons {"Lascia così", item 2 of argv} default button 2 with title "double-claude" with icon caution' -e 'return button returned of result' -e 'end run' "$1" "$2" 2>/dev/null)
  [[ $r == $2 ]]
}
quit_pids() { # chiude le app con NSRunningApplication e aspetta fino a 15 secondi
  osascript -l JavaScript -e 'function run(a){ObjC.import("AppKit");a.forEach(function(p){var x=$.NSRunningApplication.runningApplicationWithProcessIdentifier(Number(p));if(x&&!x.isNil())x.terminate;});}' "$@" >/dev/null 2>&1
  local i p alive
  for i in {1..30}; do
    alive=0; for p in "$@"; do kill -0 "$p" 2>/dev/null && alive=1; done
    (( alive )) || return 0
    sleep 0.5
  done
  return 1
}
dock_has_clone() { command defaults read com.apple.dock persistent-apps 2>/dev/null | grep -qF -- "${DC_CLONE:h:t}"; }
lsreg() {
  local x=${DC_LSREGISTER:-/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister}
  [[ -x $x ]] && "$x" -f "$1" >/dev/null 2>&1; return 0
}

# Versioni: la copia si rifà solo se è più vecchia dell'app. Se è più nuova (si è aggiornata da sola) o illeggibile, resta.
appver() {
  local f=$1/Contents/Info.plist
  if whence -p plutil >/dev/null; then plutil -extract CFBundleShortVersionString raw -o - "$f" 2>/dev/null
  else awk '/<key>CFBundleShortVersionString<\/key>/{getline; gsub(/.*<string>|<\/string>.*/,""); print; exit}' "$f" 2>/dev/null; fi
}
vercmp() { # vercmp COPIA SORGENTE → behind | same | ahead | unknown
  [[ $1 == [0-9]##(.[0-9]##)# && $2 == [0-9]##(.[0-9]##)# ]] || { print unknown; return; }
  local -a a=(${(s:.:)1}) b=(${(s:.:)2}); local i n=$(( $#a > $#b ? $#a : $#b ))
  for (( i = 1; i <= n; i++ )); do
    (( ${a[i]:-0} < ${b[i]:-0} )) && { print behind; return; }
    (( ${a[i]:-0} > ${b[i]:-0} )) && { print ahead; return; }
  done
  print same
}
clone_state() { [[ -d $DC_CLONE ]] || { print missing; return; }; vercmp "$(appver "$DC_CLONE")" "$(appver "$DC_APP_SRC")"; }
clone_recover() { # resti di una ricostruzione interrotta
  local R=$DC_CLONE.refreshing P=$DC_CLONE.previous
  if [[ -d $P ]]; then if [[ -d $DC_CLONE ]]; then rm -rf "$P"; else mv "$P" "$DC_CLONE"; fi; fi
  [[ -e $R ]] && rm -rf "$R"
  return 0
}
CLONE_DID=''
build_clone() { # la copia nuova nasce accanto e prende il posto della vecchia solo quando è completa
  clone_recover
  CLONE_DID=$(clone_state)
  [[ $CLONE_DID == (missing|behind) ]] || return 0
  local R=$DC_CLONE.refreshing P=$DC_CLONE.previous
  mkdir -p "${DC_CLONE:h}"
  cp -cR "$DC_APP_SRC" "$R" 2>/dev/null || { rm -rf "$R"; cp -R "$DC_APP_SRC" "$R"; } || { rm -rf "$R"; return 1; }
  [[ -f $R/Contents/Info.plist ]] || { rm -rf "$R"; return 1; }
  if [[ -d $DC_CLONE ]]; then mv "$DC_CLONE" "$P" || { rm -rf "$R"; return 1; }; fi
  if ! mv "$R" "$DC_CLONE"; then [[ -d $P ]] && mv "$P" "$DC_CLONE"; return 1; fi
  rm -rf "$P"
  lsreg "$DC_CLONE"
}
block_updates() { [[ -d $DC_B_3P && ! -f $DC_B_3P/.double-claude ]] && { print foreign; return; }; engine policy-set 2>/dev/null; }

open_a() {
  local p; p=$(mains "$DC_APP_SRC" | grep -v -- '--user-data-dir=' | awk 'NR==1{print $1}')
  [[ -n $p ]] && { focus "$p"; return; }
  open -n -a "$DC_APP_SRC"
}
open_b() {
  local p; p=$(mains "$DC_CLONE" | grep -F -- "--user-data-dir=$DC_B_DATA" | awk 'NR==1{print $1}')
  [[ -n $p ]] && { focus "$p"; return; }
  local -a bad=(${(f)"$(strays)"})
  if (( $#bad )); then
    if ! dialog "$DC_B_APP è già aperta, ma senza il suo profilo: mostra l'account $DC_A_LABEL. La chiudo e la riapro con l'account $DC_B_LABEL?" "Riapri"; then
      focus "$bad[1]"; return 0
    fi
    quit_pids $bad || { dialog "$DC_B_APP non si chiude. Chiudila con ⌘Q, poi riaprila da qui." "OK"; return 1; }
  fi
  build_clone || return 1
  [[ -d $DC_B_3P ]] || block_updates >/dev/null
  open -n -a "$DC_CLONE" --env CLAUDE_CONFIG_DIR="$DC_B_CFG" --args "--user-data-dir=$DC_B_DATA"
}
mk_launcher() { # mk_launcher "Nome app" a|b
  local L="$HOME/Applications/$1.app" lbl icns
  [[ $2 == a ]] && lbl=$DC_A_LABEL || lbl=$DC_B_LABEL
  mkdir -p "$HOME/Applications"
  if [[ -e $L ]]; then mkdir -p "$BK/launcher"; mv "$L" "$BK/launcher/"; fi
  # Senza & il launcher aspetta: da macOS 27 i processi lanciati da un'app chiusa vengono interrotti.
  osacompile -o "$L" -e "do shell script \"'$SELF' open $2 > /dev/null 2>&1\"" || return 1
  plutil -replace CFBundleIdentifier -string "local.double-claude.$lbl" "$L/Contents/Info.plist"
  (( DC_LAUNCHER_HIDE )) && plutil -replace LSUIElement -bool true "$L/Contents/Info.plist"
  icns=($DC_APP_SRC/Contents/Resources/*.icns(N))   # il nome dell'icona cambia tra le versioni
  if (( $#icns )); then cp "$icns[1]" "$L/Contents/Resources/applet.icns"; rm -f "$L/Contents/Resources/Assets.car"; fi
  print -r -- "$2 $DC_VERSION" > "$L/Contents/Resources/double-claude"   # segno di riconoscimento per doctor
  codesign -f -s - "$L" >/dev/null 2>&1
  lsreg "$L"
  return 0
}

# ---------------------------------------------------------------- backup
BK=''
cpc() { # copia APFS istantanea (cp -c), se non si può una copia normale
  if [[ -d $1 ]]; then cp -cRp "$1" "$2" 2>/dev/null || { rm -rf "$2"; cp -Rp "$1" "$2"; }
  else cp -cp "$1" "$2" 2>/dev/null || cp -p "$1" "$2"; fi
}
do_backup() { # do_backup [backup da non cancellare]
  local base=$DC_HOME_CFG/backups/$(date +%Y%m%d-%H%M%S) i=1
  BK=$base.noindex
  while [[ -e $BK ]]; do BK=${base}_$((i++)).noindex; done   # due backup nello stesso secondo: _1 si ordina dopo
  mkdir -p "$BK"
  [[ -d $DC_A_CFG ]] && cpc "$DC_A_CFG" "$BK/claude"
  [[ -f $DC_A_JSON ]] && cpc "$DC_A_JSON" "$BK/claude.json"
  [[ -f $HOME/.zshrc ]] && cpc "$HOME/.zshrc" "$BK/zshrc"
  [[ -d $DC_B_CFG ]] && cpc "$DC_B_CFG" "$BK/profile-b"
  [[ -f $DC_HOME_CFG/state.json ]] && cpc "$DC_HOME_CFG/state.json" "$BK/state.json"
  ok "backup in $(tilde $BK)"
  local -a all=($DC_HOME_CFG/backups/*.noindex(N/nOn)) old=(); local b n=0
  for b in $all; do (( ++n > DC_KEEP_BACKUPS )) && [[ $b != ${1:-} ]] && old+=("$b"); done
  if (( $#old )); then rm -rf "${old[@]}"; say "    ${_d}tolti $#old backup vecchi: ne tengo $DC_KEEP_BACKUPS${_r}"; fi
  return 0
}

