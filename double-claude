cmd_install() {
  local dst=$HOME/.local/bin/double-claude fresh=0
  h1 "Double Claude $DC_VERSION · installazione" "Double Claude $DC_VERSION · install"
  zsh -n "$SELF" 2>/dev/null || die "lo script in $(tilde $SELF) è incompleto o non è Double Claude. Copialo di nuovo dalla pagina." "the script in $(tilde $SELF) is incomplete or is not Double Claude. Copy it again."
  ok "script completo ($(wc -l < "$SELF" | tr -d ' ') righe)" "script complete ($(wc -l < "$SELF" | tr -d ' ') lines)"
  mkdir -p "${dst:h}"
  if [[ $SELF != $dst ]]; then cp "$SELF" "$dst"; fi
  chmod +x "$dst"
  ok "installato in $(tilde $dst)" "installed in $(tilde $dst)"
  if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
    if ! grep -qsF '.local/bin' "$HOME/.zshrc"; then
      print -r -- 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.zshrc"
      ok "aggiunto ~/.local/bin al PATH in ~/.zshrc" "added ~/.local/bin to PATH in ~/.zshrc"
    fi
    fresh=1
  fi
  is_mac || warn "Double Claude è fatto per macOS: qui funziona solo in parte" "Double Claude is made for macOS: here it works only in part"
  whence -p claude >/dev/null && ok "Claude Code trovato" "Claude Code found" || warn "non trovo il comando claude: installa prima Claude Code" "claude command not found: install Claude Code first"
  print
  if (( fresh )); then say "Fatto. Apri un nuovo Terminale e scrivi ${_b}double-claude init${_r}" "Done. Open a new Terminal and type ${_b}double-claude init${_r}"
  else say "Fatto. Ora scrivi ${_b}double-claude init${_r}" "Done. Now type ${_b}double-claude init${_r}"; fi
}

cmd_init() {
