build_clone() { # build_clone [force]: la copia nuova nasce accanto e prende il posto della vecchia solo quando è completa
  clone_recover
  CLONE_DID=$(clone_state)
  if [[ $CLONE_DID != (missing|behind) ]]; then
    [[ ${1:-} == force ]] || return 0
    CLONE_DID=redressed   # stessa versione, rifatta per cambiarle l'icona
  fi
  local R=$DC_CLONE.refreshing P=$DC_CLONE.previous
  mkdir -p "${DC_CLONE:h}"
  cp -cR "$DC_APP_SRC" "$R" 2>/dev/null || { rm -rf "$R"; cp -R "$DC_APP_SRC" "$R"; } || { rm -rf "$R"; return 1; }
  [[ -f $R/Contents/Info.plist ]] || { rm -rf "$R"; return 1; }
  dress_clone "$R"   # l'etichetta va messa ora: dopo la prima apertura macOS non lascia più modificare l'app
  if [[ -d $DC_CLONE ]]; then mv "$DC_CLONE" "$P" || { rm -rf "$R"; return 1; }; fi
  if ! mv "$R" "$DC_CLONE"; then [[ -d $P ]] && mv "$P" "$DC_CLONE"; return 1; fi
  rm -rf "$P"
  lsreg "$DC_CLONE"
