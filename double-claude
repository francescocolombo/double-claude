      kv "$(settings_of $x settings-check)"
      if [[ -n ${KV[error]:-} ]]; then ko "$lbl: ${KV[error]}"; continue; fi
      if (( KV[deny_missing] + KV[deny_stale] == 0 )); then ok "$lbl non può leggere i dati di $other" "$lbl can't read the data of $other"
      else
        (( KV[deny_missing] )) && ko "$lbl: mancano ${KV[deny_missing]} divieti" "$lbl: ${KV[deny_missing]} deny rules missing"
        (( KV[deny_stale] )) && ko "$lbl: ${KV[deny_stale]} divieti di una configurazione precedente da togliere" "$lbl: ${KV[deny_stale]} deny rules from a previous setup to remove"
        hint "double-claude apply deny"
      fi
      if (( $#ds )); then
        if (( KV[block] && ! KV[dirs_missing] )); then ok "$lbl legge file solo da: $(dirs_of $ds)" "$lbl reads files only from: $(dirs_of $ds)"
        else ko "$lbl può leggere file fuori dalle sue cartelle" "$lbl can read files outside its folders"; hint "double-claude apply deny"; fi
      elif (( KV[block_ours] )); then ko "$lbl ha ancora il blocco delle letture di una configurazione precedente" "$lbl still has the read block from a previous setup"; hint "double-claude apply deny"; fi
      if (( DC_SANDBOX )); then (( KV[sandbox] )) && ok "$lbl: sandbox attivo" "$lbl: sandbox on" || { ko "$lbl: sandbox non attivo" "$lbl: sandbox off"; hint "double-claude apply deny"; }
      elif (( KV[sandbox_ours] )); then ko "$lbl: sandbox rimasto attivo da una configurazione precedente" "$lbl: sandbox left on by a previous setup"; hint "double-claude apply deny"; fi
    done
    local old; old=$(block_too_old)
    if has_dirs && [[ -n $old ]]; then ko "Claude Code $old non conosce il blocco delle letture (serve $BLOCK_MIN)" "Claude Code $old doesn't know the read block (needs $BLOCK_MIN)"; hint "aggiorna con: claude update" "update with: claude update"; fi
  fi

  if has_mod app; then
    h2 "App Desktop" "Desktop app"
    if [[ ! -d $DC_APP_SRC ]]; then ko "non trovo $DC_APP_SRC" "can't find $DC_APP_SRC"
    else
      local v; v=$(appver "$DC_CLONE")
      case $(clone_state) in
        missing) ko "manca la copia dell'app per $DC_B_LABEL" "the app copy for $DC_B_LABEL is missing"; hint "double-claude apply app";;
        behind)  warn "la copia ($v) è più vecchia di $DC_A_APP: si aggiorna al prossimo clic sul launcher" "the copy ($v) is older than $DC_A_APP: it updates on the next launcher click";;
        ahead)   ok "copia dell'app per $DC_B_LABEL ($v, più recente di $DC_A_APP: la tengo)" "app copy for $DC_B_LABEL ($v, newer than $DC_A_APP: keeping it)";;
        unknown) warn "non leggo la versione della copia: la lascio com'è" "can't read the copy's version: leaving it as it is";;
        *)       ok "copia dell'app per $DC_B_LABEL aggiornata ($v)" "app copy for $DC_B_LABEL up to date ($v)";;
      esac
      [[ -e $DC_CLONE.refreshing || -e $DC_CLONE.previous ]] && warn "un aggiornamento della copia si è interrotto: si sistema al prossimo clic sul launcher" "an update of the copy was interrupted: it gets fixed on the next launcher click"
      case ${S[updates_b]} in
        off) ok "la copia non si aggiorna da sola${${(M)S[updates_ours]:#0}:+ ${_d}(blocco già presente in $(tilde $DC_B_3P))${_r}}" "the copy doesn't update itself${${(M)S[updates_ours]:#0}:+ ${_d}(block already present in $(tilde $DC_B_3P))${_r}}";;
        on)  ko "la copia si aggiorna da sola e si riapre sull'account $DC_A_LABEL" "the copy updates itself and reopens on the $DC_A_LABEL account"
             if [[ ${S[updates_ours]} == 1 ]]; then hint "double-claude apply app"
             else hint "$(tilde $DC_B_3P) non è di double-claude (forse un gateway di inferenza): non la tocco. Blocca gli aggiornamenti lì dentro." "$(tilde $DC_B_3P) is not from double-claude (maybe an inference gateway): leaving it alone. Block updates in there."; fi;;
        *)   ko "la copia si aggiorna da sola e si riapre sull'account $DC_A_LABEL" "the copy updates itself and reopens on the $DC_A_LABEL account"; hint "double-claude apply app";;
      esac
      [[ -n $(strays) ]] && { ko "$DC_B_APP è aperta senza il suo profilo e mostra l'account $DC_A_LABEL" "$DC_B_APP is open without its profile and shows the $DC_A_LABEL account"; hint "chiudila con ⌘Q e riaprila dal launcher $DC_B_APP" "quit it with ⌘Q and reopen it from the $DC_B_APP launcher"; }
      dock_has_clone && { ko "nel Dock è fissata la copia di $DC_B_APP, non il launcher: da lì si apre sull'account $DC_A_LABEL" "the $DC_B_APP copy is pinned in the Dock, not the launcher: from there it opens on the $DC_A_LABEL account"
        hint "tasto destro sull'icona nel Dock → Opzioni → Rimuovi dal Dock$( (( DC_LAUNCHER_HIDE )) && print ', poi apri da Spotlight' || print ', poi fissa il launcher')" "right-click the Dock icon → Options → Remove from Dock$( (( DC_LAUNCHER_HIDE )) && print ', then open from Spotlight' || print ', then pin the launcher')"; }
      local L="$HOME/Applications/$DC_B_APP.app" m=''
      [[ -f $L/Contents/Resources/double-claude ]] && m=$(<$L/Contents/Resources/double-claude)
      if [[ ! -d $L ]]; then ko "manca il launcher $DC_B_APP" "the $DC_B_APP launcher is missing"; hint "double-claude apply app"
      elif [[ $m == *' '* ]]; then ok "il launcher $DC_B_APP passa CLAUDE_CONFIG_DIR" "the $DC_B_APP launcher passes CLAUDE_CONFIG_DIR"
      elif [[ -n $m ]]; then warn "il launcher $DC_B_APP è della versione 1.0: lavora in background e da macOS 27 può fermarsi a metà" "the $DC_B_APP launcher is from version 1.0: it runs in the background and since macOS 27 it can stop halfway"; hint "double-claude apply app"
      else
        warn "il launcher $DC_B_APP non è di double-claude: verifica che passi CLAUDE_CONFIG_DIR" "the $DC_B_APP launcher is not from double-claude: check that it passes CLAUDE_CONFIG_DIR"
        local scpt=$L/Contents/Resources/Scripts/main.scpt
        if whence -p osadecompile >/dev/null && [[ -f $scpt ]] && osadecompile "$scpt" 2>/dev/null | grep -qE '&[[:space:]]*\\?"'; then
          warn "lancia in background (&): da macOS 27 l'aggiornamento della copia può restare a metà" "it runs in the background (&): since macOS 27 updating the copy can stop halfway"
        fi
        hint "double-claude apply app lo sostituisce (il vecchio va nel backup)" "double-claude apply app replaces it (the old one goes into the backup)"
      fi
      [[ -d $DC_B_DATA ]] && ok "$DC_B_APP ha i suoi dati" "$DC_B_APP has its own data" || { warn "$DC_B_APP non è mai stata aperta" "$DC_B_APP has never been opened"; hint "aprila da Spotlight e fai il login con l'account $DC_B_LABEL" "open it from Spotlight and sign in with the $DC_B_LABEL account"; }
      if icon_broken "$DC_CLONE"; then ko "l'icona di $DC_B_APP è rotta: il Dock mostra una cartella" "the $DC_B_APP icon is broken: the Dock shows a folder"; hint "chiudi $DC_B_APP e riaprila dal launcher: la copia si rifà con l'icona giusta" "quit $DC_B_APP and reopen it from the launcher: the copy is rebuilt with the right icon"
      elif badge_on b; then
        if ! icon_stale; then ok "etichetta $(badge_text b) sull'icona di $DC_B_APP" "$(badge_text b) label on the $DC_B_APP icon"
        else warn "l'icona di $DC_B_APP non ha ancora l'etichetta scelta" "the $DC_B_APP icon doesn't have the chosen label yet"; hint "chiudi $DC_B_APP e riaprila dal launcher" "quit $DC_B_APP and reopen it from the launcher"; fi
      fi
    fi
    say "    ${_d}Controllo a mano: nella scheda Code di $DC_B_APP scrivi «esegui echo \$CLAUDE_CONFIG_DIR».${_r}" "    ${_d}Manual check: in the Code tab of $DC_B_APP type «run echo \$CLAUDE_CONFIG_DIR».${_r}"
    say "    ${_d}Deve rispondere $DC_B_CFG.${_r}" "    ${_d}It must answer $DC_B_CFG.${_r}"
  fi

  print
  if (( DC_TODO == 0 )); then say "${_g}${_b}Tutto separato.${_r}" "${_g}${_b}All separated.${_r}"
  else say "${_b}$DC_TODO $( (( DC_TODO == 1 )) && print cosa || print cose ) da sistemare.${_r} Segui le frecce →, poi rilancia ${_b}double-claude doctor${_r}." "${_b}$DC_TODO $( (( DC_TODO == 1 )) && print thing || print things ) to fix.${_r} Follow the arrows →, then run ${_b}double-claude doctor${_r} again."; fi
}

cmd_plan() {
  need_conf; load
  h1 "double-claude · piano  ${_d}niente viene modificato${_r}" "double-claude · plan  ${_d}nothing is changed${_r}"
  say "  ${_d}Prima di tutto: backup in $(tilde $DC_HOME_CFG/backups)${_r}" "  ${_d}First of all: backup in $(tilde $DC_HOME_CFG/backups)${_r}"
  if has_mod shell; then
    h2 "shell · comando $DC_B_CMD" "shell · $DC_B_CMD command"
    say "  Crea $(tilde $DC_B_CFG) e aggiunge questo blocco a ~/.zshrc:" "  Creates $(tilde $DC_B_CFG) and adds this block to ~/.zshrc:"
    local -a todo=(); local d; for d in $DC_A_DIRS $DC_B_DIRS; do [[ -d $d ]] || todo+=("$(tilde $d)"); done
    (( $#todo )) && say "  Crea anche le cartelle dedicate: ${(j:, :)todo}" "  Also creates the dedicated folders: ${(j:, :)todo}"
    zsh_block | sed 's/^/    /'
  fi
  if has_mod move; then
    h2 "move · chat e cronologia" "move · chats and history"
    DC_DRY=1 engine move | sed 's/^/  /'
  fi
  if has_mod mcp && (( $#DC_MCP_MOVE )); then
    h2 "mcp · server" "mcp · servers"
    say "  Da $DC_A_LABEL a $DC_B_LABEL: ${DC_MCP_MOVE[*]}" "  From $DC_A_LABEL to $DC_B_LABEL: ${DC_MCP_MOVE[*]}"
  fi
  if has_mod deny; then
    h2 "deny · divieti e letture" "deny · deny rules and reads"
    say "  $DC_A_LABEL non tocca:" "  $DC_A_LABEL doesn't touch:"; rules_a | sed 's/^/    /'
    say "  $DC_B_LABEL non tocca:" "  $DC_B_LABEL doesn't touch:"; rules_b | sed 's/^/    /'
    (( $#DC_A_DIRS )) && say "  $DC_A_LABEL legge file solo da: $(dirs_of $DC_A_DIRS)" "  $DC_A_LABEL reads files only from: $(dirs_of $DC_A_DIRS)"
    (( $#DC_B_DIRS )) && say "  $DC_B_LABEL legge file solo da: $(dirs_of $DC_B_DIRS)" "  $DC_B_LABEL reads files only from: $(dirs_of $DC_B_DIRS)"
    (( DC_SANDBOX )) && say "  Sandbox per i comandi Bash dei due profili" "  Sandbox for the Bash commands of both profiles"
  fi
  if has_mod app; then
    h2 "app · seconda app Desktop" "app · second Desktop app"
    say "  Copia:     $(tilde $DC_CLONE)" "  Copy:      $(tilde $DC_CLONE)"
    say "  Dati:      $(tilde $DC_B_DATA)" "  Data:      $(tilde $DC_B_DATA)"
    say "  Launcher:  ~/Applications/$DC_A_APP.app, ~/Applications/$DC_B_APP.app $( (( DC_LAUNCHER_HIDE )) && print '(fuori dal Dock)' || print '(si possono fissare nel Dock)')" "  Launchers: ~/Applications/$DC_A_APP.app, ~/Applications/$DC_B_APP.app $( (( DC_LAUNCHER_HIDE )) && print '(out of the Dock)' || print '(can be pinned in the Dock)')"
    if any_badge; then
      local -a where=(); badge_on a && where+=("$(badge_text a) $(L "sul launcher di" "on the launcher of") $DC_A_LABEL")
      badge_on b && where+=("$(badge_text b) $(L "sul launcher e sulla copia di" "on the launcher and copy of") $DC_B_LABEL")
      say "  $(L "Etichette: " "Labels:    ")${(j:; :)where} ($(L "icona" "icon") $([[ $DC_ICON_STYLE == dark ]] && L scura dark || L classica classic))"
    fi
    if [[ -d $DC_B_3P && ! -f $DC_B_3P/.double-claude ]]; then say "  Aggiornamenti: $(tilde $DC_B_3P) esiste già e non è di double-claude, non la tocco" "  Updates:   $(tilde $DC_B_3P) already exists and is not from double-claude, leaving it alone"
    else say "  Aggiornamenti: bloccati per la copia con una policy in $(tilde $DC_B_3P)" "  Updates:   blocked for the copy with a policy in $(tilde $DC_B_3P)"; fi
  fi
  print; hint "per procedere: double-claude apply" "to go ahead: double-claude apply"
}

apply_shell() {
  h2 "shell · comando $DC_B_CMD" "shell · $DC_B_CMD command"
  mkdir -p "$DC_B_CFG"
  touch "$HOME/.zshrc"
  strip_block "$HOME/.zshrc"
  [[ -s $HOME/.zshrc && -n "$(tail -c1 "$HOME/.zshrc")" ]] && print >> "$HOME/.zshrc"
  zsh_block >> "$HOME/.zshrc"
  ok "aggiunto a ~/.zshrc" "added to ~/.zshrc"
  local d; for d in $DC_A_DIRS $DC_B_DIRS; do
    [[ -d $d ]] || { mkdir -p "$d" && ok "creata la cartella $(tilde $d)" "created the folder $(tilde $d)"; }
  done
  local al; al=$(grep -nE "^[[:space:]]*alias[[:space:]]+(claude|$DC_B_CMD)=" "$HOME/.zshrc")
  [[ -n $al ]] && warn "un alias scavalca le funzioni (riga ${al%%:*} di ~/.zshrc): toglilo" "an alias overrides the functions (line ${al%%:*} of ~/.zshrc): remove it"
  hint "apri un nuovo Terminale per usarlo" "open a new Terminal to use it"
  if [[ ! -f $DC_B_CFG/.claude.json ]] || ! grep -q emailAddress "$DC_B_CFG/.claude.json" 2>/dev/null; then
    say "  Login di $DC_B_LABEL:" "  Sign in to $DC_B_LABEL:"
    say "    1. nel browser esci da claude.ai (o usa una finestra privata)" "    1. in the browser, sign out of claude.ai (or use a private window)"
    say "    2. in un nuovo Terminale: ${_b}cd $(b_start) && $DC_B_CMD${_r}" "    2. in a new Terminal: ${_b}cd $(b_start) && $DC_B_CMD${_r}"
    say "    3. dentro scrivi ${_b}/login${_r} e accedi con l'account $DC_B_LABEL" "    3. type ${_b}/login${_r} and sign in with the $DC_B_LABEL account"
  fi
}

apply_move() {
  h2 "move · chat e cronologia" "move · chats and history"
  has_dirs || say "  ${_d}Senza cartelle dedicate sposto solo le chat della scheda Code di $DC_B_APP.${_r}" "  ${_d}Without dedicated folders I only move chats from the Code tab of $DC_B_APP.${_r}"
  local r; r=$(running)
  if [[ -n $r ]]; then
    warn "Claude è aperto e riscrive i suoi file mentre gira:" "Claude is open and rewrites its files while running:"
    print -r -- "$r" | sed 's/^/      /'
    say "    Chiudi le app con ⌘Q e i Terminali dove gira claude." "    Quit the apps with ⌘Q and the Terminals where claude is running."
    confirm "$(L "Continuo lo stesso?" "Continue anyway?")" N || return 1
  fi
  DC_DRY=1 engine move | sed 's/^/  /'
  confirm "$(L Sposto? Move?)" S || return 0
  DC_DRY=0 engine move | sed 's/^/  /' | tail -n 1
}

apply_mcp() {
  h2 "mcp · server" "mcp · servers"
  (( $#DC_MCP_MOVE )) || { ok "nessun server da spostare" "no servers to move"; return 0; }
  [[ -n $CLAUDE_BIN ]] || { ko "comando claude non trovato" "claude command not found"; return 1; }
  scan
  local s j
  for s in $DC_MCP_MOVE; do
    j=$(DC_ARG=$s engine mcp-get 2>/dev/null)
    if [[ " ${S[mcp_b]} " != *" $s "* ]]; then
      [[ -n $j ]] || { warn "$s non è tra i server globali di $DC_A_LABEL" "$s is not among the global servers of $DC_A_LABEL"; continue; }
      if CLAUDE_CONFIG_DIR=$DC_B_CFG "$CLAUDE_BIN" mcp add-json "$s" "$j" -s user >/dev/null 2>&1; then ok "$s aggiunto a $DC_B_LABEL" "$s added to $DC_B_LABEL"
      else ko "$s: non riesco ad aggiungerlo a $DC_B_LABEL" "$s: can't add it to $DC_B_LABEL"; continue; fi
    fi
    if [[ -n $j ]]; then
      "$CLAUDE_BIN" mcp remove "$s" -s user >/dev/null 2>&1 && ok "$s tolto da $DC_A_LABEL" "$s removed from $DC_A_LABEL" || ko "$s: non riesco a toglierlo da $DC_A_LABEL" "$s: can't remove it from $DC_A_LABEL"
    fi
  done
}

apply_deny() {
  h2 "deny · divieti e letture" "deny · deny rules and reads"
  local x lbl msg; local -a ds
  for x in a b; do
    if [[ $x == a ]]; then lbl=$DC_A_LABEL ds=($DC_A_DIRS); else lbl=$DC_B_LABEL ds=($DC_B_DIRS); fi
    kv "$(settings_of $x settings)"
    if [[ -n ${KV[error]:-} ]]; then ko "$lbl: ${KV[error]}"; continue; fi
    msg="$lbl: $(L "${KV[added]} divieti aggiunti" "${KV[added]} deny rules added")"; (( KV[removed] )) && msg+=$(L ", ${KV[removed]} tolti perché non servono più" ", ${KV[removed]} removed as no longer needed")
    ok "$msg"
    (( $#ds )) && ok "$lbl legge file solo da: $(dirs_of $ds)" "$lbl reads files only from: $(dirs_of $ds)"
  done
  local old; old=$(block_too_old)
  if has_dirs && [[ -n $old ]]; then warn "Claude Code $old non conosce ancora il blocco delle letture: aggiorna con claude update" "Claude Code $old doesn't know the read block yet: update with claude update"; fi
  if (( DC_SANDBOX )); then ok "sandbox attivo per i comandi Bash dei due profili" "sandbox on for the Bash commands of both profiles"; hint "la rete dei comandi passa da un elenco di siti: Claude ti chiede ogni sito nuovo" "network access for commands goes through an allowlist: Claude asks you about each new site"
  else hint "i divieti valgono per gli strumenti file e per cat, sed e simili, non per script o grep -r: per quelli c'è il sandbox (double-claude init)" "deny rules apply to file tools and to cat, sed and the like, not to scripts or grep -r: for those there is the sandbox (double-claude init)"; fi
}

apply_app() {
  h2 "app · seconda app Desktop" "app · second Desktop app"
  is_mac || { warn "solo su macOS" "macOS only"; return 0; }
  [[ -d $DC_APP_SRC ]] || { ko "non trovo $DC_APP_SRC" "can't find $DC_APP_SRC"; return 1; }
  [[ $SELF == */Downloads/* || $SELF == /tmp/* || $SELF == /private/* ]] && warn "i launcher useranno $(tilde $SELF): meglio prima 'double-claude install'" "launchers will use $(tilde $SELF): better run 'double-claude install' first"
  local r=0
  if build_clone; then
    case $CLONE_DID in
      missing) ok "copia dell'app in $(tilde ${DC_CLONE:h})" "app copy in $(tilde ${DC_CLONE:h})";;
      behind)  ok "copia dell'app aggiornata alla versione di $DC_A_APP" "app copy updated to the version of $DC_A_APP";;
      ahead)   ok "la copia è più recente di $DC_A_APP: la tengo" "the copy is newer than $DC_A_APP: keeping it";;
      unknown) warn "non leggo la versione della copia: la lascio com'è" "can't read the copy's version: leaving it as it is";;
      *)       ok "copia dell'app già aggiornata" "app copy already up to date";;
    esac
  else ko "non riesco a copiare l'app: la copia di prima resta com'era" "can't copy the app: the previous copy stays as it was"; r=1; fi
  case $(block_updates) in
    ours)    ok "aggiornamento automatico della copia bloccato" "automatic updates of the copy blocked";;
    foreign) warn "$(tilde $DC_B_3P) esiste già e non è di double-claude: non la tocco" "$(tilde $DC_B_3P) already exists and is not from double-claude: leaving it alone"
             hint "se la copia si aggiorna da sola si riapre sull'account $DC_A_LABEL: double-claude doctor lo controlla" "if the copy updates itself it reopens on the $DC_A_LABEL account: double-claude doctor checks it";;
    *)       ko "non riesco a bloccare l'aggiornamento automatico della copia" "can't block automatic updates of the copy"; r=1;;
  esac
  mk_launcher "$DC_A_APP" a && ok "launcher ~/Applications/$DC_A_APP.app" "launcher ~/Applications/$DC_A_APP.app"
  mk_launcher "$DC_B_APP" b && ok "launcher ~/Applications/$DC_B_APP.app ${_d}(passa CLAUDE_CONFIG_DIR)${_r}" "launcher ~/Applications/$DC_B_APP.app ${_d}(passes CLAUDE_CONFIG_DIR)${_r}"
  if icon_stale; then
    if b_running; then
      warn "$DC_B_APP è aperta: la sua icona cambia alla prossima apertura dal launcher" "$DC_B_APP is open: its icon changes the next time you open it from the launcher"
      hint "chiudila con ⌘Q e riaprila dal launcher $DC_B_APP" "quit it with ⌘Q and reopen it from the $DC_B_APP launcher"
    elif build_clone force; then
      case $DRESS in failed) warn "non riesco a disegnare l'etichetta di $DC_B_APP: resta l'icona di Claude" "can't draw the $DC_B_APP label: it keeps Claude's icon";; esac
    fi
  fi
  if any_badge; then
    local -a lab=(); badge_on a && lab+=("$(badge_text a)"); badge_on b && lab+=("$(badge_text b)")
    ok "etichette sulle icone: ${(j:, :)lab}" "icon labels: ${(j:, :)lab}"
  fi
  (( DC_LAUNCHER_HIDE )) && hint "i launcher restano fuori dal Dock: aprili da Spotlight" "launchers stay out of the Dock: open them from Spotlight" || hint "per il Dock fissa i launcher, non le app aperte" "for the Dock, pin the launchers, not the open apps"
  say "  Primo avvio:" "  First launch:"
  say "    1. chiudi Claude con ⌘Q e nel browser esci da claude.ai" "    1. quit Claude with ⌘Q and sign out of claude.ai in the browser"
  say "    2. apri ${_b}$DC_B_APP${_r} da Spotlight e accedi con l'account $DC_B_LABEL" "    2. open ${_b}$DC_B_APP${_r} from Spotlight and sign in with the $DC_B_LABEL account"
  say "    3. da ora apri sempre ${_b}$DC_A_APP${_r} e ${_b}$DC_B_APP${_r} dai launcher" "    3. from now on always open ${_b}$DC_A_APP${_r} and ${_b}$DC_B_APP${_r} from the launchers"
  say "    4. nascondi /Applications/Claude.app da Spotlight (Impostazioni di Sistema → Spotlight)" "    4. hide /Applications/Claude.app from Spotlight (System Settings → Spotlight)"
  say "  ${_d}Per distinguerle nel Dock: Finder → Ottieni informazioni sulla copia → trascina un'icona su quella in alto.${_r}" "  ${_d}To tell them apart in the Dock: Finder → Get Info on the copy → drag an icon onto the one at the top.${_r}"
  return $r
}

cmd_apply() {
  need_conf; load
  local -a mods=("$@"); (( $#mods )) || mods=($DC_MODULES)
  local m; for m in $mods; do [[ $m == (shell|move|mcp|deny|app) ]] || die "pezzo sconosciuto: $m (usa shell, move, mcp, deny, app)" "unknown piece: $m (use shell, move, mcp, deny, app)"; done
  h1 "double-claude · apply  ${_d}${mods[*]}${_r}"
  do_backup
  for m in $mods; do apply_$m || warn "$m non completato" "$m not completed"; done
  print; hint "controlla con: double-claude doctor" "check with: double-claude doctor"
}

cmd_open() {
  load
  case ${1:-} in
    a|$DC_A_LABEL) open_a;;
    b|$DC_B_LABEL) open_b;;
    *) die "uso: double-claude open $DC_A_LABEL|$DC_B_LABEL" "usage: double-claude open $DC_A_LABEL|$DC_B_LABEL";;
  esac
}

cmd_status() {
  load
  h1 "double-claude · app aperte" "double-claude · open apps"
  local line pid any=0
  while read -r line; do
    [[ -z $line ]] && continue; any=1; pid=${line%% *}
    if [[ $line == *--user-data-dir=* ]]; then say "  ${_o}B${_r} $DC_B_LABEL  ${_d}pid $pid${_r}"
    elif [[ $line == *"$DC_CLONE/"* ]]; then say "  ${_red}!${_r} $DC_B_APP senza il suo profilo: mostra l'account $DC_A_LABEL  ${_d}pid $pid${_r}" "  ${_red}!${_r} $DC_B_APP without its profile: shows the $DC_A_LABEL account  ${_d}pid $pid${_r}"
    else say "  ${_a}A${_r} $DC_A_LABEL  ${_d}pid $pid${_r}"; fi
  done < <(ps -A -o pid= -o command= 2>/dev/null | grep -E '\.app/Contents/MacOS/Claude( --|$)' | grep -v grep | sed 's/^ *//')
  (( any )) || say "  ${_d}nessuna app Claude aperta${_r}" "  ${_d}no Claude app open${_r}"
}

cmd_backup() { load; h1 "double-claude · backup"; do_backup; }

cmd_restore() {
  load
  local -a all=($DC_HOME_CFG/backups/*.noindex(N/nOn))
  (( $#all )) || die "nessun backup in $(tilde $DC_HOME_CFG/backups)" "no backups in $(tilde $DC_HOME_CFG/backups)"
  h1 "double-claude · restore"
  local i=1 b; for b in $all; do say "  $i) ${b:t:r}"; (( i++ )); done
  local n; ask n "$(L Quale? Which?)" 1
  local src=${all[$n]}; [[ -d $src ]] || die "scelta non valida" "invalid choice"
  [[ -z $(running) ]] || die "chiudi prima le app Claude e i Terminali dove gira claude." "first quit the Claude apps and the Terminals where claude is running."
  confirm "$(L "Riporto tutto a ${src:t:r}? Prima salvo lo stato attuale." "Restore everything to ${src:t:r}? I save the current state first.")" S || return 0
  do_backup "$src"
  [[ -d $src/claude ]]      && { rm -rf "$DC_A_CFG"; cpc "$src/claude" "$DC_A_CFG"; ok "~/.claude"; }
  [[ -f $src/claude.json ]] && { rm -f "$DC_A_JSON"; cpc "$src/claude.json" "$DC_A_JSON"; ok "~/.claude.json"; }
  [[ -f $src/zshrc ]]       && { cp -p "$src/zshrc" "$HOME/.zshrc"; ok "~/.zshrc"; }
  if [[ -f $src/state.json ]]; then cp -p "$src/state.json" "$DC_HOME_CFG/state.json"; else rm -f "$DC_HOME_CFG/state.json"; fi
  if [[ -d $src/profile-b ]]; then rm -rf "$DC_B_CFG"; cpc "$src/profile-b" "$DC_B_CFG"; ok "$(tilde $DC_B_CFG)"
  elif [[ -d $DC_B_CFG ]]; then rm -rf "$DC_B_CFG"; ok "$(tilde $DC_B_CFG) tolta: in quel backup non esisteva ancora" "$(tilde $DC_B_CFG) removed: it didn't exist yet in that backup"; fi
  hint "lo stato di prima è nel backup appena fatto: $(tilde $BK)" "the previous state is in the backup just made: $(tilde $BK)"
}

# ================================================================ avvio
local -a args; local want_lang=0
for a in "$@"; do
  if (( want_lang )); then DC_LANG_FORCE=$a; want_lang=0; continue; fi
  case $a in -y|--yes) DC_YES=1;; --lang) want_lang=1;; --lang=*) DC_LANG_FORCE=${a#--lang=};; *) args+=("$a");; esac
done
set -- "${args[@]}"
if [[ -n $DC_LANG_FORCE ]]; then DC_UI=$(lang_of $DC_LANG_FORCE); else DC_UI=$(system_lang); fi
case ${1:-help} in
  init)       cmd_init;;
  doctor)     cmd_doctor;;
  plan)       cmd_plan;;
  apply)      shift; cmd_apply "$@";;
  open)       shift; cmd_open "$@";;
  status)     cmd_status;;
  backup)     cmd_backup;;
  restore)    cmd_restore;;
  install)    cmd_install;;
  -v|--version|version) print $DC_VERSION;;
  help|-h|--help) cmd_help;;
  *) cmd_help; exit 1;;
esac
