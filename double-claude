  say "   1) Ho un solo account e voglio aggiungerne un secondo" "   1) I have one account and want to add a second one"
  say "   2) Ho due account ma un solo profilo: chat e impostazioni si mescolano" "   2) I have two accounts but one profile: chats and settings get mixed"
  say "   3) Ho già due profili, ma qualcosa passa dall'uno all'altro" "   3) I already have two profiles, but something leaks from one to the other"
  local n; ask n "$(L Scegli Choose)" ${${(M)DC_START:#one}:+1}${${(M)DC_START:#two}:+2}${${(M)DC_START:#split}:+3}
  case $n in 1) DC_START=one;; 3) DC_START=split;; *) DC_START=two;; esac

  h2 "2. I nomi" "2. Names"
  say "   ${_d}A è il profilo che usi già (~/.claude, app Claude). B è il secondo.${_r}" "   ${_d}A is the profile you already use (~/.claude, Claude app). B is the second one.${_r}"
  ask DC_A_LABEL "$(L "Nome di A" "Name of A")" "$DC_A_LABEL"
  ask DC_B_LABEL "$(L "Nome di B" "Name of B")" "$DC_B_LABEL"
  [[ $DC_A_LABEL == [a-z0-9-]## && $DC_B_LABEL == [a-z0-9-]## ]] || die "usa solo minuscole, numeri e trattini nei nomi." "use only lowercase letters, numbers and hyphens in names."
  [[ $DC_A_LABEL != $DC_B_LABEL ]] || die "i due nomi devono essere diversi." "the two names must be different."
  unset DC_B_CMD DC_B_APP DC_B_CFG DC_B_DATA DC_CLONE; derive
  say "   B avrà: comando ${_b}$DC_B_CMD${_r}, config ${_b}$(tilde $DC_B_CFG)${_r}, app ${_b}$DC_B_APP${_r}" "   B will have: command ${_b}$DC_B_CMD${_r}, config ${_b}$(tilde $DC_B_CFG)${_r}, app ${_b}$DC_B_APP${_r}"

  h2 "3. Cartelle dedicate ${_d}(facoltativo)${_r}" "3. Dedicated folders ${_d}(optional)${_r}"
  local A=$DC_A_LABEL Bl=$DC_B_LABEL
  say "   Un profilo con una cartella dedicata lavora solo lì. Le cartelle le crea apply, se non esistono." "   A profile with a dedicated folder works only there. apply creates the folders if they don't exist."
  say "   1) Nessuna cartella dedicata: i due comandi funzionano ovunque" "   1) No dedicated folder: both commands work everywhere"
  say "   2) $Bl lavora solo nella cartella ~/Documents/$Bl, $A ovunque tranne lì" "   2) $Bl works only in ~/Documents/$Bl, $A everywhere else"
  say "   3) $A lavora solo nella cartella ~/Documents/$A, $Bl ovunque tranne lì" "   3) $A works only in ~/Documents/$A, $Bl everywhere else"
  say "   4) Una cartella per ciascuno: ~/Documents/$A e ~/Documents/$Bl" "   4) One folder each: ~/Documents/$A and ~/Documents/$Bl"
  local cur_choice=1
  (( $#DC_B_DIRS && ! $#DC_A_DIRS )) && cur_choice=2
  (( $#DC_A_DIRS && ! $#DC_B_DIRS )) && cur_choice=3
  (( $#DC_A_DIRS && $#DC_B_DIRS )) && cur_choice=4
  ask n "$(L Scegli Choose)" $cur_choice
  local want_a=0 want_b=0
  case $n in 2) want_b=1;; 3) want_a=1;; 4) want_a=1 want_b=1;; esac
  ask_dirs() { # ask_dirs a|b etichetta: chiede le cartelle e le salva in DC_A_DIRS o DC_B_DIRS
    local var=DC_${(U)1}_DIRS cur d ans; cur=$(dirs_of ${(P)var})
    ask ans "$(L "Cartella di $2 (più di una: separale con la virgola)" "Folder of $2 (more than one: separate with commas)")" "${cur:-~/Documents/$2}"
    local -a out=(); for d in ${(s:,:)ans}; do d=${${d## #}%% #}; [[ -n $d ]] && out+=("$(expand $d)"); done
    (( $#out )) || die "serve almeno una cartella." "at least one folder is needed."
    set -A $var "${out[@]}"
  }
  if (( want_a )); then ask_dirs a $A; else DC_A_DIRS=(); fi
  if (( want_b )); then ask_dirs b $Bl; else DC_B_DIRS=(); fi
  if (( want_a && want_b )); then
    local d e; for d in $DC_A_DIRS; do for e in $DC_B_DIRS; do
      [[ $d == $e || $d/ == $e/* || $e/ == $d/* ]] && die "le cartelle di $A e di $Bl non possono stare una dentro l'altra." "the folders of $A and $Bl can't be inside one another."
    done; done
  fi

  h2 "4. Server MCP" "4. MCP servers"
  local -a in_a
  if [[ -f $DC_A_JSON ]]; then scan; in_a=(${(s: :)S[mcp_a]}); fi
  if (( $#in_a )); then
    say "   In $DC_A_LABEL ci sono: ${_b}${in_a[*]}${_r}" "   $DC_A_LABEL has: ${_b}${in_a[*]}${_r}"
    [[ $DC_START == one ]] && say "   ${_d}Con un solo account di solito non serve: lascia vuoto.${_r}" "   ${_d}With a single account you usually don't need this: leave it empty.${_r}"
    ask n "$(L "Quali passano a $DC_B_LABEL? (nomi separati da spazio, vuoto = nessuno)" "Which ones move to $DC_B_LABEL? (names separated by spaces, empty = none)")" "${DC_MCP_MOVE[*]}"
    DC_MCP_MOVE=(${(s: :)n})
  else
    say "   ${_d}Nessun server MCP globale in $DC_A_LABEL.${_r}" "   ${_d}No global MCP servers in $DC_A_LABEL.${_r}"; DC_MCP_MOVE=()
  fi

  h2 "5. Cosa separare" "5. What to separate"
  DC_MODULES=(shell)
  say "   ${_d}Il comando $DC_B_CMD nel Terminale è sempre incluso.${_r}" "   ${_d}The $DC_B_CMD command in the Terminal is always included.${_r}"
  if has_dirs; then
    if [[ $DC_START == one ]]; then confirm "$(L "Alcune chat fatte finora sono di $DC_B_LABEL e vanno spostate?" "Do some chats made so far belong to $DC_B_LABEL and need moving?")" N && DC_MODULES+=(move)
    else confirm "$(L "Sposto in $DC_B_LABEL le chat e la cronologia che gli appartengono?" "Move the chats and history that belong to $DC_B_LABEL?")" S && DC_MODULES+=(move); fi
  elif [[ $DC_START != one ]]; then
    say "   ${_d}Senza cartelle dedicate riconosco solo le chat fatte nella scheda Code di $DC_B_APP: le altre restano dove sono.${_r}" "   ${_d}Without dedicated folders I can only recognize chats made in the Code tab of $DC_B_APP: the others stay where they are.${_r}"
    confirm "$(L "Sposto in $DC_B_LABEL le chat della scheda Code di $DC_B_APP finite in $DC_A_LABEL?" "Move to $DC_B_LABEL the chats from the Code tab of $DC_B_APP that ended up in $DC_A_LABEL?")" S && DC_MODULES+=(move)
  fi
  (( $#DC_MCP_MOVE )) && DC_MODULES+=(mcp)
  if confirm "$(L "Aggiungo i divieti, così nessuno dei due legge i dati dell'altro?" "Add deny rules, so neither can read the other's data?")" S; then
    DC_MODULES+=(deny)
    (( $#DC_A_DIRS )) && say "   ${_d}$DC_A_LABEL leggerà file solo dalle sue cartelle.${_r}" "   ${_d}$DC_A_LABEL will read files only from its folders.${_r}"
    (( $#DC_B_DIRS )) && say "   ${_d}$DC_B_LABEL leggerà file solo dalle sue cartelle.${_r}" "   ${_d}$DC_B_LABEL will read files only from its folders.${_r}"
    say "   ${_d}I divieti valgono per gli strumenti file e per comandi come cat e sed, non per script o grep -r.${_r}" "   ${_d}Deny rules apply to file tools and to commands like cat and sed, not to scripts or grep -r.${_r}"
    say "   ${_d}Il sandbox li applica a tutti i comandi, ma la rete passa da un elenco di siti: Claude ti chiede ogni sito nuovo.${_r}" "   ${_d}The sandbox applies them to every command, but network access goes through an allowlist: Claude asks you about each new site.${_r}"
    if confirm "$(L "Attivo anche il sandbox?" "Turn on the sandbox too?")" $( (( DC_SANDBOX )) && print S || print N); then DC_SANDBOX=1; else DC_SANDBOX=0; fi
  fi
  if is_mac && [[ -d $DC_APP_SRC ]]; then
    if confirm "$(L "Creo una seconda app Desktop per $DC_B_LABEL ($DC_B_APP)?" "Create a second Desktop app for $DC_B_LABEL ($DC_B_APP)?")" S; then
      DC_MODULES+=(app)
      say "   ${_d}I launcher possono stare nel Dock (e si possono fissare) oppure restarne fuori (si aprono da Spotlight).${_r}" "   ${_d}Launchers can live in the Dock (and be pinned) or stay out of it (open them from Spotlight).${_r}"
      if confirm "$(L "Tengo i launcher fuori dal Dock?" "Keep the launchers out of the Dock?")" $( (( DC_LAUNCHER_HIDE )) && print S || print N); then DC_LAUNCHER_HIDE=1; else DC_LAUNCHER_HIDE=0; fi
      say "   $(L "Etichetta col nome del profilo sulle icone (launcher e Dock):" "Label with the profile name on the icons (launchers and Dock):")"
      say "   1) $(L Nessuna None)"; say "   2) $(L "Solo" "Only") $(badge_text b)"; say "   3) $(L "Solo" "Only") $(badge_text a)"; say "   4) $(L "Tutte e due" "Both")"
      local lc=1; badge_on b && lc=2; badge_on a && lc=3; badge_on a && badge_on b && lc=4
      ask n "$(L Scegli Choose)" $lc
      case $n in 2) DC_ICON_LABELS=b;; 3) DC_ICON_LABELS=a;; 4) DC_ICON_LABELS=both;; *) DC_ICON_LABELS=none;; esac
      if any_badge; then
        say "   $(L "Stile dell'icona con etichetta:" "Style of the labeled icon:")"
        say "   1) $(L "Classica, arancione" "Classic, orange")"; say "   2) $(L "Scura, come Claude in modalità scura" "Dark, like Claude in dark mode")"
        ask n "$(L Scegli Choose)" $([[ $DC_ICON_STYLE == dark ]] && print 2 || print 1)
        [[ $n == 2 ]] && DC_ICON_STYLE=dark || DC_ICON_STYLE=classic
      fi
    fi
  else
    say "   ${_d}App Desktop non trovata in $DC_APP_SRC: salto la seconda app.${_r}" "   ${_d}Desktop app not found in $DC_APP_SRC: skipping the second app.${_r}"
  fi

  save_conf
  h2 "Fatto" "Done"
  ok "configurazione salvata in $(tilde $DC_CONF)" "configuration saved in $(tilde $DC_CONF)"
  if [[ $DC_START == split ]]; then hint "ora: double-claude doctor" "next: double-claude doctor"; else hint "ora: double-claude plan, poi double-claude apply" "next: double-claude plan, then double-claude apply"; fi
}

