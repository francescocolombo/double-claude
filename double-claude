cmd_install() {
  local dst=$HOME/.local/bin/double-claude fresh=0
  h1 "Double Claude $DC_VERSION · installazione"
  zsh -n "$SELF" 2>/dev/null || die "lo script in $(tilde $SELF) è incompleto o non è Double Claude. Copialo di nuovo dalla pagina."
  ok "script completo ($(wc -l < "$SELF" | tr -d ' ') righe)"
  mkdir -p "${dst:h}"
  if [[ $SELF != $dst ]]; then cp "$SELF" "$dst"; fi
  chmod +x "$dst"
  ok "installato in $(tilde $dst)"
  if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
    if ! grep -qsF '.local/bin' "$HOME/.zshrc"; then
      print -r -- 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.zshrc"
      ok "aggiunto ~/.local/bin al PATH in ~/.zshrc"
    fi
    fresh=1
  fi
  is_mac || warn "Double Claude è fatto per macOS: qui funziona solo in parte"
  whence -p claude >/dev/null && ok "Claude Code trovato" || warn "non trovo il comando claude: installa prima Claude Code"
  print
  if (( fresh )); then say "Fatto. Apri un nuovo Terminale e scrivi ${_b}double-claude init${_r}"
  else say "Fatto. Ora scrivi ${_b}double-claude init${_r}"; fi
}

cmd_init() {
  load
  h1 "double-claude · configurazione"
  say "Due account Claude, separati su quattro livelli: account, app, Claude Code, cartelle."
  say "${_d}Rispondi a qualche domanda. Niente cambia finché non lanci 'double-claude apply'.${_r}"

  h2 "1. Da dove parti?"
  say "   ${_d}Account: l'email con cui entri in Claude. Profilo: dove Claude tiene chat e impostazioni su questo Mac.${_r}"
  say "   1) Ho un solo account e voglio aggiungerne un secondo"
  say "   2) Ho due account ma un solo profilo: chat e impostazioni si mescolano"
  say "   3) Ho già due profili, ma qualcosa passa dall'uno all'altro"
  local n; ask n "Scegli" ${${(M)DC_START:#one}:+1}${${(M)DC_START:#two}:+2}${${(M)DC_START:#split}:+3}
  case $n in 1) DC_START=one;; 3) DC_START=split;; *) DC_START=two;; esac

  h2 "2. I nomi"
  say "   ${_d}A è il profilo che usi già (~/.claude, app Claude). B è il secondo.${_r}"
  ask DC_A_LABEL "Nome di A" "$DC_A_LABEL"
  ask DC_B_LABEL "Nome di B" "$DC_B_LABEL"
  [[ $DC_A_LABEL == [a-z0-9-]## && $DC_B_LABEL == [a-z0-9-]## ]] || die "usa solo minuscole, numeri e trattini nei nomi."
  [[ $DC_A_LABEL != $DC_B_LABEL ]] || die "i due nomi devono essere diversi."
  unset DC_B_CMD DC_B_APP DC_B_CFG DC_B_DATA DC_CLONE; derive
  say "   B avrà: comando ${_b}$DC_B_CMD${_r}, config ${_b}$(tilde $DC_B_CFG)${_r}, app ${_b}$DC_B_APP${_r}"

  h2 "3. Cartelle dedicate ${_d}(facoltativo)${_r}"
  local A=$DC_A_LABEL Bl=$DC_B_LABEL
  say "   Un profilo con una cartella dedicata lavora solo lì. Le cartelle le crea apply, se non esistono."
  say "   1) Nessuna cartella dedicata: i due comandi funzionano ovunque"
  say "   2) $Bl lavora solo nella cartella ~/Documents/$Bl, $A ovunque tranne lì"
  say "   3) $A lavora solo nella cartella ~/Documents/$A, $Bl ovunque tranne lì"
  say "   4) Una cartella per ciascuno: ~/Documents/$A e ~/Documents/$Bl"
  local cur_choice=1
  (( $#DC_B_DIRS && ! $#DC_A_DIRS )) && cur_choice=2
  (( $#DC_A_DIRS && ! $#DC_B_DIRS )) && cur_choice=3
  (( $#DC_A_DIRS && $#DC_B_DIRS )) && cur_choice=4
  ask n "Scegli" $cur_choice
  local want_a=0 want_b=0
  case $n in 2) want_b=1;; 3) want_a=1;; 4) want_a=1 want_b=1;; esac
  ask_dirs() { # ask_dirs a|b etichetta: chiede le cartelle e le salva in DC_A_DIRS o DC_B_DIRS
    local var=DC_${(U)1}_DIRS cur d ans; cur=$(dirs_of ${(P)var})
    ask ans "Cartella di $2 (più di una: separale con la virgola)" "${cur:-~/Documents/$2}"
    local -a out=(); for d in ${(s:,:)ans}; do d=${${d## #}%% #}; [[ -n $d ]] && out+=("$(expand $d)"); done
    (( $#out )) || die "serve almeno una cartella."
    set -A $var "${out[@]}"
  }
  if (( want_a )); then ask_dirs a $A; else DC_A_DIRS=(); fi
  if (( want_b )); then ask_dirs b $Bl; else DC_B_DIRS=(); fi
  if (( want_a && want_b )); then
    local d e; for d in $DC_A_DIRS; do for e in $DC_B_DIRS; do
      [[ $d == $e || $d/ == $e/* || $e/ == $d/* ]] && die "le cartelle di $A e di $Bl non possono stare una dentro l'altra."
    done; done
  fi

  h2 "4. Server MCP"
  local -a in_a
  if [[ -f $DC_A_JSON ]]; then scan; in_a=(${(s: :)S[mcp_a]}); fi
  if (( $#in_a )); then
    say "   In $DC_A_LABEL ci sono: ${_b}${in_a[*]}${_r}"
    [[ $DC_START == one ]] && say "   ${_d}Con un solo account di solito non serve: lascia vuoto.${_r}"
    ask n "Quali passano a $DC_B_LABEL? (nomi separati da spazio, vuoto = nessuno)" "${DC_MCP_MOVE[*]}"
    DC_MCP_MOVE=(${(s: :)n})
  else
    say "   ${_d}Nessun server MCP globale in $DC_A_LABEL.${_r}"; DC_MCP_MOVE=()
  fi

  h2 "5. Cosa separare"
  DC_MODULES=(shell)
  say "   ${_d}Il comando $DC_B_CMD nel Terminale è sempre incluso.${_r}"
  if has_dirs; then
    if [[ $DC_START == one ]]; then confirm "Alcune chat fatte finora sono di $DC_B_LABEL e vanno spostate?" N && DC_MODULES+=(move)
    else confirm "Sposto in $DC_B_LABEL le chat e la cronologia che gli appartengono?" S && DC_MODULES+=(move); fi
  elif [[ $DC_START != one ]]; then
    say "   ${_d}Senza cartelle dedicate riconosco solo le chat fatte nella scheda Code di $DC_B_APP: le altre restano dove sono.${_r}"
    confirm "Sposto in $DC_B_LABEL le chat della scheda Code di $DC_B_APP finite in $DC_A_LABEL?" S && DC_MODULES+=(move)
  fi
  (( $#DC_MCP_MOVE )) && DC_MODULES+=(mcp)
  if confirm "Aggiungo i divieti, così nessuno dei due legge i dati dell'altro?" S; then
    DC_MODULES+=(deny)
    (( $#DC_A_DIRS )) && say "   ${_d}$DC_A_LABEL leggerà file solo dalle sue cartelle.${_r}"
    (( $#DC_B_DIRS )) && say "   ${_d}$DC_B_LABEL leggerà file solo dalle sue cartelle.${_r}"
    say "   ${_d}I divieti valgono per gli strumenti file e per comandi come cat e sed, non per script o grep -r.${_r}"
    say "   ${_d}Il sandbox li applica a tutti i comandi, ma la rete passa da un elenco di siti: Claude ti chiede ogni sito nuovo.${_r}"
    if confirm "Attivo anche il sandbox?" $( (( DC_SANDBOX )) && print S || print N); then DC_SANDBOX=1; else DC_SANDBOX=0; fi
  fi
  if is_mac && [[ -d $DC_APP_SRC ]]; then
    if confirm "Creo una seconda app Desktop per $DC_B_LABEL ($DC_B_APP)?" S; then
      DC_MODULES+=(app)
      say "   ${_d}I launcher possono stare nel Dock (e si possono fissare) oppure restarne fuori (si aprono da Spotlight).${_r}"
      if confirm "Tengo i launcher fuori dal Dock?" $( (( DC_LAUNCHER_HIDE )) && print S || print N); then DC_LAUNCHER_HIDE=1; else DC_LAUNCHER_HIDE=0; fi
    fi
  else
    say "   ${_d}App Desktop non trovata in $DC_APP_SRC: salto la seconda app.${_r}"
  fi

  save_conf
  h2 "Fatto"
  ok "configurazione salvata in $(tilde $DC_CONF)"
  if [[ $DC_START == split ]]; then hint "ora: double-claude doctor"; else hint "ora: double-claude plan, poi double-claude apply"; fi
}

cmd_doctor() {
  need_conf; load; scan
  DC_TODO=0
  h1 "double-claude · diagnosi  ${_d}$DC_A_LABEL (A) · $DC_B_LABEL (B)${_r}"

  h2 "Account"
  [[ ${S[json_a]} == broken ]] && { ko "~/.claude.json non è un JSON valido"; hint "ripristina un backup: double-claude restore"; }
  [[ -n ${S[account_a]} ]] && ok "$DC_A_LABEL: ${S[account_a]}" || warn "$DC_A_LABEL: nessun login trovato in ~/.claude.json"
  if [[ ! -d $DC_B_CFG ]]; then ko "$DC_B_LABEL non ha ancora una config ($(tilde $DC_B_CFG))"; hint "double-claude apply shell"
  elif [[ -z ${S[account_b]} ]]; then ko "$DC_B_LABEL: nessun login"; hint "esci da claude.ai nel browser, poi: cd $(b_start) && $DC_B_CMD e dentro /login"
  else ok "$DC_B_LABEL: ${S[account_b]}"; fi
  [[ -n ${S[account_a]} && ${S[account_a]} == ${S[account_b]} ]] && { ko "A e B usano lo stesso account"; hint "esci da claude.ai nel browser, poi /logout e /login in $DC_B_CMD"; }
  if [[ ${S[app_same]} == 1 ]]; then
    ko "le app $DC_A_APP e $DC_B_APP usano lo stesso account"
    hint "chiudi $DC_A_APP, poi in $DC_B_APP esci e rientra con l'account $DC_B_LABEL (il link di accesso va all'app aperta)"
  fi

  h2 "Terminale"
  [[ -n $CLAUDE_BIN ]] && ok "claude installato ($(tilde $CLAUDE_BIN))" || ko "comando claude non trovato"
  if grep -qs '^# >>> double-claude >>>' "$HOME/.zshrc"; then ok "comando $DC_B_CMD in ~/.zshrc"
  elif grep -qsF -- "$DC_B_CFG" "$HOME/.zshrc" || grep -qsF -- "$(tilde $DC_B_CFG)" "$HOME/.zshrc"; then ok "comando $DC_B_CMD in ~/.zshrc ${_d}(creato a mano)${_r}"
  else ko "manca il comando $DC_B_CMD"; hint "double-claude apply shell"; fi
  local al; al=$(grep -nE "^[[:space:]]*alias[[:space:]]+(claude|$DC_B_CMD)=" "$HOME/.zshrc" 2>/dev/null)
  [[ -n $al ]] && { ko "un alias scavalca le funzioni (riga ${al%%:*} di ~/.zshrc)"; hint "togli quella riga"; }

  if has_dirs; then
    h2 "Cartelle dedicate"
    local x lbl d; for x in a b; do
      local -a ds=(${(P)${:-DC_${(U)x}_DIRS}}); [[ $x == a ]] && lbl=$DC_A_LABEL || lbl=$DC_B_LABEL
      (( $#ds )) || { say "    ${_d}$lbl: nessuna, lavora ovunque tranne nelle cartelle dell'altro${_r}"; continue; }
      for d in $ds; do [[ -d $d ]] && ok "$lbl lavora solo in $(tilde $d)" || { ko "manca la cartella $(tilde $d) di $lbl"; hint "double-claude apply shell la crea"; }; done
    done
  else
    h2 "Cartelle dedicate"
    say "    ${_d}Nessuna: claude e $DC_B_CMD funzionano in ogni cartella. Per sceglierne una: double-claude init.${_r}"
  fi

  h2 "Chat e cronologia"
  local c=${S[chats_b]} h=${S[history_b]} r=${S[registry_b]}
  if (( c + h + r == 0 )); then
    if has_dirs; then ok "in $DC_A_LABEL non c'è niente di $DC_B_LABEL"
    else ok "in $DC_A_LABEL non ci sono chat della scheda Code di $DC_B_APP"; fi
  else ko "in $DC_A_LABEL ci sono dati di $DC_B_LABEL: $c chat, $h righe di cronologia, $r voci di registro"; hint "double-claude apply move"; fi

  if (( $#DC_MCP_MOVE )) || [[ -n ${S[mcp_a]}${S[mcp_b]} ]]; then
    h2 "Server MCP"
    say "    ${_d}$DC_A_LABEL: ${S[mcp_a]:-nessuno} · $DC_B_LABEL: ${S[mcp_b]:-nessuno}${_r}"
    local s; for s in $DC_MCP_MOVE; do
      if [[ " ${S[mcp_a]} " == *" $s "* ]]; then ko "$s è ancora in $DC_A_LABEL"; hint "double-claude apply mcp"
      elif [[ " ${S[mcp_b]} " == *" $s "* ]]; then ok "$s è solo in $DC_B_LABEL"
      else warn "$s non c'è in nessuno dei due"; fi
    done
  fi

  if has_mod deny; then
    h2 "Divieti e letture"
    local x lbl other; local -a ds
    for x in a b; do
      if [[ $x == a ]]; then lbl=$DC_A_LABEL other=$DC_B_LABEL ds=($DC_A_DIRS); else lbl=$DC_B_LABEL other=$DC_A_LABEL ds=($DC_B_DIRS); fi
      kv "$(settings_of $x settings-check)"
      if [[ -n ${KV[error]:-} ]]; then ko "$lbl: ${KV[error]}"; continue; fi
      if (( KV[deny_missing] + KV[deny_stale] == 0 )); then ok "$lbl non può leggere i dati di $other"
      else
        (( KV[deny_missing] )) && ko "$lbl: mancano ${KV[deny_missing]} divieti"
        (( KV[deny_stale] )) && ko "$lbl: ${KV[deny_stale]} divieti di una configurazione precedente da togliere"
        hint "double-claude apply deny"
      fi
      if (( $#ds )); then
        if (( KV[block] && ! KV[dirs_missing] )); then ok "$lbl legge file solo da: $(dirs_of $ds)"
        else ko "$lbl può leggere file fuori dalle sue cartelle"; hint "double-claude apply deny"; fi
      elif (( KV[block_ours] )); then ko "$lbl ha ancora il blocco delle letture di una configurazione precedente"; hint "double-claude apply deny"; fi
      if (( DC_SANDBOX )); then (( KV[sandbox] )) && ok "$lbl: sandbox attivo" || { ko "$lbl: sandbox non attivo"; hint "double-claude apply deny"; }
      elif (( KV[sandbox_ours] )); then ko "$lbl: sandbox rimasto attivo da una configurazione precedente"; hint "double-claude apply deny"; fi
    done
    local old; old=$(block_too_old)
    if has_dirs && [[ -n $old ]]; then ko "Claude Code $old non conosce il blocco delle letture (serve $BLOCK_MIN)"; hint "aggiorna con: claude update"; fi
  fi

  if has_mod app; then
    h2 "App Desktop"
    if [[ ! -d $DC_APP_SRC ]]; then ko "non trovo $DC_APP_SRC"
    else
      local v; v=$(appver "$DC_CLONE")
      case $(clone_state) in
        missing) ko "manca la copia dell'app per $DC_B_LABEL"; hint "double-claude apply app";;
        behind)  warn "la copia ($v) è più vecchia di $DC_A_APP: si aggiorna al prossimo clic sul launcher";;
        ahead)   ok "copia dell'app per $DC_B_LABEL ($v, più recente di $DC_A_APP: la tengo)";;
        unknown) warn "non leggo la versione della copia: la lascio com'è";;
        *)       ok "copia dell'app per $DC_B_LABEL aggiornata ($v)";;
      esac
      [[ -e $DC_CLONE.refreshing || -e $DC_CLONE.previous ]] && warn "un aggiornamento della copia si è interrotto: si sistema al prossimo clic sul launcher"
      case ${S[updates_b]} in
        off) ok "la copia non si aggiorna da sola${${(M)S[updates_ours]:#0}:+ ${_d}(blocco già presente in $(tilde $DC_B_3P))${_r}}";;
        on)  ko "la copia si aggiorna da sola e si riapre sull'account $DC_A_LABEL"
             if [[ ${S[updates_ours]} == 1 ]]; then hint "double-claude apply app"
             else hint "$(tilde $DC_B_3P) non è di double-claude (forse un gateway di inferenza): non la tocco. Blocca gli aggiornamenti lì dentro."; fi;;
        *)   ko "la copia si aggiorna da sola e si riapre sull'account $DC_A_LABEL"; hint "double-claude apply app";;
      esac
      [[ -n $(strays) ]] && { ko "$DC_B_APP è aperta senza il suo profilo e mostra l'account $DC_A_LABEL"; hint "chiudila con ⌘Q e riaprila dal launcher $DC_B_APP"; }
      dock_has_clone && { ko "nel Dock è fissata la copia di $DC_B_APP, non il launcher: da lì si apre sull'account $DC_A_LABEL"
        hint "tasto destro sull'icona nel Dock → Opzioni → Rimuovi dal Dock$( (( DC_LAUNCHER_HIDE )) && print ', poi apri da Spotlight' || print ', poi fissa il launcher')"; }
      local L="$HOME/Applications/$DC_B_APP.app" m=''
      [[ -f $L/Contents/Resources/double-claude ]] && m=$(<$L/Contents/Resources/double-claude)
      if [[ ! -d $L ]]; then ko "manca il launcher $DC_B_APP"; hint "double-claude apply app"
      elif [[ $m == *' '* ]]; then ok "il launcher $DC_B_APP passa CLAUDE_CONFIG_DIR"
      elif [[ -n $m ]]; then warn "il launcher $DC_B_APP è della versione 1.0: lavora in background e da macOS 27 può fermarsi a metà"; hint "double-claude apply app"
      else
        warn "il launcher $DC_B_APP non è di double-claude: verifica che passi CLAUDE_CONFIG_DIR"
        local scpt=$L/Contents/Resources/Scripts/main.scpt
        if whence -p osadecompile >/dev/null && [[ -f $scpt ]] && osadecompile "$scpt" 2>/dev/null | grep -qE '&[[:space:]]*\\?"'; then
          warn "lancia in background (&): da macOS 27 l'aggiornamento della copia può restare a metà"
        fi
        hint "double-claude apply app lo sostituisce (il vecchio va nel backup)"
      fi
      [[ -d $DC_B_DATA ]] && ok "$DC_B_APP ha i suoi dati" || { warn "$DC_B_APP non è mai stata aperta"; hint "aprila da Spotlight e fai il login con l'account $DC_B_LABEL"; }
    fi
    say "    ${_d}Controllo a mano: nella scheda Code di $DC_B_APP scrivi «esegui echo \$CLAUDE_CONFIG_DIR».${_r}"
    say "    ${_d}Deve rispondere $DC_B_CFG.${_r}"
  fi

  print
  if (( DC_TODO == 0 )); then say "${_g}${_b}Tutto separato.${_r}"
  else say "${_b}$DC_TODO $( (( DC_TODO == 1 )) && print cosa || print cose ) da sistemare.${_r} Segui le frecce →, poi rilancia ${_b}double-claude doctor${_r}."; fi
}

cmd_plan() {
  need_conf; load
  h1 "double-claude · piano  ${_d}niente viene modificato${_r}"
  say "  ${_d}Prima di tutto: backup in $(tilde $DC_HOME_CFG/backups)${_r}"
  if has_mod shell; then
    h2 "shell · comando $DC_B_CMD"
    say "  Crea $(tilde $DC_B_CFG) e aggiunge questo blocco a ~/.zshrc:"
    local -a todo=(); local d; for d in $DC_A_DIRS $DC_B_DIRS; do [[ -d $d ]] || todo+=("$(tilde $d)"); done
    (( $#todo )) && say "  Crea anche le cartelle dedicate: ${(j:, :)todo}"
    zsh_block | sed 's/^/    /'
  fi
  if has_mod move; then
    h2 "move · chat e cronologia"
    DC_DRY=1 engine move | sed 's/^/  /'
  fi
  if has_mod mcp && (( $#DC_MCP_MOVE )); then
    h2 "mcp · server"
    say "  Da $DC_A_LABEL a $DC_B_LABEL: ${DC_MCP_MOVE[*]}"
  fi
  if has_mod deny; then
    h2 "deny · divieti e letture"
    say "  $DC_A_LABEL non tocca:"; rules_a | sed 's/^/    /'
    say "  $DC_B_LABEL non tocca:"; rules_b | sed 's/^/    /'
    (( $#DC_A_DIRS )) && say "  $DC_A_LABEL legge file solo da: $(dirs_of $DC_A_DIRS)"
    (( $#DC_B_DIRS )) && say "  $DC_B_LABEL legge file solo da: $(dirs_of $DC_B_DIRS)"
    (( DC_SANDBOX )) && say "  Sandbox per i comandi Bash dei due profili"
  fi
  if has_mod app; then
    h2 "app · seconda app Desktop"
    say "  Copia:     $(tilde $DC_CLONE)"
    say "  Dati:      $(tilde $DC_B_DATA)"
    say "  Launcher:  ~/Applications/$DC_A_APP.app, ~/Applications/$DC_B_APP.app $( (( DC_LAUNCHER_HIDE )) && print '(fuori dal Dock)' || print '(si possono fissare nel Dock)')"
    if [[ -d $DC_B_3P && ! -f $DC_B_3P/.double-claude ]]; then say "  Aggiornamenti: $(tilde $DC_B_3P) esiste già e non è di double-claude, non la tocco"
    else say "  Aggiornamenti: bloccati per la copia con una policy in $(tilde $DC_B_3P)"; fi
  fi
  print; hint "per procedere: double-claude apply"
}

apply_shell() {
  h2 "shell · comando $DC_B_CMD"
  mkdir -p "$DC_B_CFG"
  touch "$HOME/.zshrc"
  strip_block "$HOME/.zshrc"
  [[ -s $HOME/.zshrc && -n "$(tail -c1 "$HOME/.zshrc")" ]] && print >> "$HOME/.zshrc"
  zsh_block >> "$HOME/.zshrc"
  ok "aggiunto a ~/.zshrc"
  local d; for d in $DC_A_DIRS $DC_B_DIRS; do
    [[ -d $d ]] || { mkdir -p "$d" && ok "creata la cartella $(tilde $d)"; }
  done
  local al; al=$(grep -nE "^[[:space:]]*alias[[:space:]]+(claude|$DC_B_CMD)=" "$HOME/.zshrc")
  [[ -n $al ]] && warn "un alias scavalca le funzioni (riga ${al%%:*} di ~/.zshrc): toglilo"
  hint "apri un nuovo Terminale per usarlo"
  if [[ ! -f $DC_B_CFG/.claude.json ]] || ! grep -q emailAddress "$DC_B_CFG/.claude.json" 2>/dev/null; then
    say "  Login di $DC_B_LABEL:"
    say "    1. nel browser esci da claude.ai (o usa una finestra privata)"
    say "    2. in un nuovo Terminale: ${_b}cd $(b_start) && $DC_B_CMD${_r}"
    say "    3. dentro scrivi ${_b}/login${_r} e accedi con l'account $DC_B_LABEL"
  fi
}

apply_move() {
  h2 "move · chat e cronologia"
  has_dirs || say "  ${_d}Senza cartelle dedicate sposto solo le chat della scheda Code di $DC_B_APP.${_r}"
  local r; r=$(running)
  if [[ -n $r ]]; then
    warn "Claude è aperto e riscrive i suoi file mentre gira:"
    print -r -- "$r" | sed 's/^/      /'
    say "    Chiudi le app con ⌘Q e i Terminali dove gira claude."
    confirm "Continuo lo stesso?" N || return 1
  fi
  DC_DRY=1 engine move | sed 's/^/  /'
  confirm "Sposto?" S || return 0
  DC_DRY=0 engine move | sed 's/^/  /' | tail -n 1
}

apply_mcp() {
  h2 "mcp · server"
  (( $#DC_MCP_MOVE )) || { ok "nessun server da spostare"; return 0; }
  [[ -n $CLAUDE_BIN ]] || { ko "comando claude non trovato"; return 1; }
  scan
  local s j
  for s in $DC_MCP_MOVE; do
    j=$(DC_ARG=$s engine mcp-get 2>/dev/null)
    if [[ " ${S[mcp_b]} " != *" $s "* ]]; then
      [[ -n $j ]] || { warn "$s non è tra i server globali di $DC_A_LABEL"; continue; }
      if CLAUDE_CONFIG_DIR=$DC_B_CFG "$CLAUDE_BIN" mcp add-json "$s" "$j" -s user >/dev/null 2>&1; then ok "$s aggiunto a $DC_B_LABEL"
      else ko "$s: non riesco ad aggiungerlo a $DC_B_LABEL"; continue; fi
    fi
    if [[ -n $j ]]; then
      "$CLAUDE_BIN" mcp remove "$s" -s user >/dev/null 2>&1 && ok "$s tolto da $DC_A_LABEL" || ko "$s: non riesco a toglierlo da $DC_A_LABEL"
    fi
  done
}

apply_deny() {
  h2 "deny · divieti e letture"
  local x lbl msg; local -a ds
  for x in a b; do
    if [[ $x == a ]]; then lbl=$DC_A_LABEL ds=($DC_A_DIRS); else lbl=$DC_B_LABEL ds=($DC_B_DIRS); fi
    kv "$(settings_of $x settings)"
    if [[ -n ${KV[error]:-} ]]; then ko "$lbl: ${KV[error]}"; continue; fi
    msg="$lbl: ${KV[added]} divieti aggiunti"; (( KV[removed] )) && msg+=", ${KV[removed]} tolti perché non servono più"
    ok "$msg"
    (( $#ds )) && ok "$lbl legge file solo da: $(dirs_of $ds)"
  done
  local old; old=$(block_too_old)
  if has_dirs && [[ -n $old ]]; then warn "Claude Code $old non conosce ancora il blocco delle letture: aggiorna con claude update"; fi
  if (( DC_SANDBOX )); then ok "sandbox attivo per i comandi Bash dei due profili"; hint "la rete dei comandi passa da un elenco di siti: Claude ti chiede ogni sito nuovo"
  else hint "i divieti valgono per gli strumenti file e per cat, sed e simili, non per script o grep -r: per quelli c'è il sandbox (double-claude init)"; fi
}

apply_app() {
  h2 "app · seconda app Desktop"
  is_mac || { warn "solo su macOS"; return 0; }
  [[ -d $DC_APP_SRC ]] || { ko "non trovo $DC_APP_SRC"; return 1; }
  [[ $SELF == */Downloads/* || $SELF == /tmp/* || $SELF == /private/* ]] && warn "i launcher useranno $(tilde $SELF): meglio prima 'double-claude install'"
  local r=0
  if build_clone; then
    case $CLONE_DID in
      missing) ok "copia dell'app in $(tilde ${DC_CLONE:h})";;
      behind)  ok "copia dell'app aggiornata alla versione di $DC_A_APP";;
      ahead)   ok "la copia è più recente di $DC_A_APP: la tengo";;
      unknown) warn "non leggo la versione della copia: la lascio com'è";;
      *)       ok "copia dell'app già aggiornata";;
    esac
  else ko "non riesco a copiare l'app: la copia di prima resta com'era"; r=1; fi
  case $(block_updates) in
    ours)    ok "aggiornamento automatico della copia bloccato";;
    foreign) warn "$(tilde $DC_B_3P) esiste già e non è di double-claude: non la tocco"
             hint "se la copia si aggiorna da sola si riapre sull'account $DC_A_LABEL: double-claude doctor lo controlla";;
    *)       ko "non riesco a bloccare l'aggiornamento automatico della copia"; r=1;;
  esac
  mk_launcher "$DC_A_APP" a && ok "launcher ~/Applications/$DC_A_APP.app"
  mk_launcher "$DC_B_APP" b && ok "launcher ~/Applications/$DC_B_APP.app ${_d}(passa CLAUDE_CONFIG_DIR)${_r}"
  (( DC_LAUNCHER_HIDE )) && hint "i launcher restano fuori dal Dock: aprili da Spotlight" || hint "per il Dock fissa i launcher, non le app aperte"
  say "  Primo avvio:"
  say "    1. chiudi Claude con ⌘Q e nel browser esci da claude.ai"
  say "    2. apri ${_b}$DC_B_APP${_r} da Spotlight e accedi con l'account $DC_B_LABEL"
  say "    3. da ora apri sempre ${_b}$DC_A_APP${_r} e ${_b}$DC_B_APP${_r} dai launcher"
  say "    4. nascondi /Applications/Claude.app da Spotlight (Impostazioni di Sistema → Spotlight)"
  say "  ${_d}Per distinguerle nel Dock: Finder → Ottieni informazioni sulla copia → trascina un'icona su quella in alto.${_r}"
  return $r
}

cmd_apply() {
  need_conf; load
  local -a mods=("$@"); (( $#mods )) || mods=($DC_MODULES)
  local m; for m in $mods; do [[ $m == (shell|move|mcp|deny|app) ]] || die "pezzo sconosciuto: $m (usa shell, move, mcp, deny, app)"; done
  h1 "double-claude · apply  ${_d}${mods[*]}${_r}"
  do_backup
  for m in $mods; do apply_$m || warn "$m non completato"; done
  print; hint "controlla con: double-claude doctor"
}

cmd_open() {
  load
  case ${1:-} in
    a|$DC_A_LABEL) open_a;;
    b|$DC_B_LABEL) open_b;;
    *) die "uso: double-claude open $DC_A_LABEL|$DC_B_LABEL";;
  esac
}

cmd_status() {
  load
  h1 "double-claude · app aperte"
  local line pid any=0
  while read -r line; do
    [[ -z $line ]] && continue; any=1; pid=${line%% *}
    if [[ $line == *--user-data-dir=* ]]; then say "  ${_o}B${_r} $DC_B_LABEL  ${_d}pid $pid${_r}"
    elif [[ $line == *"$DC_CLONE/"* ]]; then say "  ${_red}!${_r} $DC_B_APP senza il suo profilo: mostra l'account $DC_A_LABEL  ${_d}pid $pid${_r}"
    else say "  ${_a}A${_r} $DC_A_LABEL  ${_d}pid $pid${_r}"; fi
  done < <(ps -A -o pid= -o command= 2>/dev/null | grep -E '\.app/Contents/MacOS/Claude( --|$)' | grep -v grep | sed 's/^ *//')
  (( any )) || say "  ${_d}nessuna app Claude aperta${_r}"
}

cmd_backup() { load; h1 "double-claude · backup"; do_backup; }

cmd_restore() {
  load
  local -a all=($DC_HOME_CFG/backups/*.noindex(N/nOn))
  (( $#all )) || die "nessun backup in $(tilde $DC_HOME_CFG/backups)"
  h1 "double-claude · restore"
  local i=1 b; for b in $all; do say "  $i) ${b:t:r}"; (( i++ )); done
  local n; ask n "Quale?" 1
  local src=${all[$n]}; [[ -d $src ]] || die "scelta non valida"
  [[ -z $(running) ]] || die "chiudi prima le app Claude e i Terminali dove gira claude."
  confirm "Riporto tutto a ${src:t:r}? Prima salvo lo stato attuale." S || return 0
  do_backup "$src"
  [[ -d $src/claude ]]      && { rm -rf "$DC_A_CFG"; cpc "$src/claude" "$DC_A_CFG"; ok "~/.claude"; }
  [[ -f $src/claude.json ]] && { rm -f "$DC_A_JSON"; cpc "$src/claude.json" "$DC_A_JSON"; ok "~/.claude.json"; }
  [[ -f $src/zshrc ]]       && { cp -p "$src/zshrc" "$HOME/.zshrc"; ok "~/.zshrc"; }
  if [[ -f $src/state.json ]]; then cp -p "$src/state.json" "$DC_HOME_CFG/state.json"; else rm -f "$DC_HOME_CFG/state.json"; fi
  if [[ -d $src/profile-b ]]; then rm -rf "$DC_B_CFG"; cpc "$src/profile-b" "$DC_B_CFG"; ok "$(tilde $DC_B_CFG)"
  elif [[ -d $DC_B_CFG ]]; then rm -rf "$DC_B_CFG"; ok "$(tilde $DC_B_CFG) tolta: in quel backup non esisteva ancora"; fi
  hint "lo stato di prima è nel backup appena fatto: $(tilde $BK)"
}

# ================================================================ avvio
local -a args
for a in "$@"; do case $a in -y|--yes) DC_YES=1;; *) args+=("$a");; esac; done
set -- "${args[@]}"
case ${1:-help} in
  init)       cmd_init;;
  doctor)     cmd_doctor;;
  plan)       cmd_plan;;
  apply)      shift; cmd_apply "$@";;
  open)       shift; cmd_open "$@";;
  status)     cmd_status;;
  backup)     cmd_backup;;
  restore)    cmd_restore;;
  install)    cmd_install;;
  -v|--version|version) print $DC_VERSION;;
  help|-h|--help) cmd_help;;
  *) cmd_help; exit 1;;
esac
